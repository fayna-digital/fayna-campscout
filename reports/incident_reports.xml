<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ================================================================ -->
        <!-- Paper formats                                                    -->
        <!-- ================================================================ -->

        <!-- Karta Wypadku — A4 portrait, tight margins (official form) -->
        <record id="paperformat_incident_card" model="report.paperformat">
            <field name="name">Karta Wypadku A4</field>
            <field name="format">A4</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">12</field>
            <field name="margin_bottom">12</field>
            <field name="margin_left">12</field>
            <field name="margin_right">12</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">8</field>
            <field name="dpi">90</field>
        </record>

        <!-- Rejestr Wypadków — A4 landscape (10-column table for KO control) -->
        <record id="paperformat_incident_register" model="report.paperformat">
            <field name="name">Rejestr Wypadków A4 Landscape</field>
            <field name="format">A4</field>
            <field name="orientation">Landscape</field>
            <field name="margin_top">10</field>
            <field name="margin_bottom">10</field>
            <field name="margin_left">8</field>
            <field name="margin_right">8</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">6</field>
            <field name="dpi">90</field>
        </record>

        <!-- ================================================================ -->
        <!-- Report actions                                                   -->
        <!-- ================================================================ -->

        <record id="action_report_incident_card" model="ir.actions.report">
            <field name="name">Karta Wypadku (PDF)</field>
            <field name="model">camp.incident.card</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">fayna_camp_portal.report_incident_card</field>
            <field name="report_file">fayna_camp_portal.report_incident_card</field>
            <field name="binding_model_id" ref="model_camp_incident_card"/>
            <field name="binding_type">report</field>
            <field name="paperformat_id" ref="paperformat_incident_card"/>
            <field name="print_report_name">'Karta_Wypadku_%s' % (object.participant_id.display_name or '').replace(' ', '_')</field>
        </record>

        <record id="action_report_incident_register" model="ir.actions.report">
            <field name="name">Rejestr Wypadków (PDF)</field>
            <field name="model">camp.incident.register</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">fayna_camp_portal.report_incident_register</field>
            <field name="report_file">fayna_camp_portal.report_incident_register</field>
            <field name="binding_model_id" ref="model_camp_incident_register"/>
            <field name="binding_type">report</field>
            <field name="paperformat_id" ref="paperformat_incident_register"/>
            <field name="print_report_name">'Rejestr_Wypadkow_%s' % (object.event_id.name or '').replace(' ', '_')</field>
        </record>

    </data>
</odoo>
