<?xml version="1.0" encoding="utf-8"?>
<!-- §7 — Przykładowe pozycje fiskalne (account.fiscal.position) dla 3 form
     organizatora obozu. Tryb VAT kalkulatora (camp.create.wizard.vat_mode) jest
     NASTĘPSTWEM wyboru pozycji fiskalnej, nie zaszytym domyślnym ustawieniem.

     noupdate="1" — księgowa może dostosować (dodać tax_ids mapowanie); -u nie
     nadpisuje (reguła feedback_xml_noupdate_user_fields).

     UWAGA: te rekordy NIE zawierają mapowania tax_ids — to przykłady-szkielety,
     które klasyfikują tryb VAT po xml-id / nazwie. Realne mapowanie podatków
     (tax_src_id → tax_dest_id) ustawia księgowa po instalacji l10n_pl, zgodnie
     z interpretacją indywidualną (§7: człowiek-w-pętli, NIE gotowe prawnie). -->
<odoo>
    <data noupdate="1">

        <!-- Fundacja / NGO → zwolniona z VAT (art.43 ust.1 pkt 24 lit.a) -->
        <record id="fiscal_position_camp_zw" model="account.fiscal.position">
            <field name="name">Obóz — fundacja / NGO (zwolniona art.43)</field>
            <field name="auto_apply" eval="False"/>
            <field name="note">Forma oświaty + zgłoszenie do kuratorium → usługa
                opieki nad dziećmi zwolniona z VAT (art.43 ust.1 pkt 24 lit.a).
                Domyślny, bezpieczny tryb. Finalna pewność = interpretacja
                indywidualna / księgowa.</field>
        </record>

        <!-- Sp. z o.o. / firma turystyczna → VAT-marża (art.119) -->
        <record id="fiscal_position_camp_marza" model="account.fiscal.position">
            <field name="name">Obóz — firma turystyczna (VAT-marża art.119)</field>
            <field name="auto_apply" eval="False"/>
            <field name="note">Organizator wpisany do rejestru organizatorów
                turystyki → VAT 23% naliczany TYLKO od marży (art.119 ustawy o VAT).
                Stosować, gdy fiskus kwalifikuje wypoczynek jako usługę turystyki.
                Mapowanie tax_ids na "VAT Marża turystyczna" ustawia księgowa.</field>
        </record>

        <!-- JDG / inne → standard 23% -->
        <record id="fiscal_position_camp_standard" model="account.fiscal.position">
            <field name="name">Obóz — standard 23% (JDG / inne)</field>
            <field name="auto_apply" eval="False"/>
            <field name="note">Pełna stawka VAT 23% od całej ceny usługi. Stosować,
                gdy nie przysługuje ani zwolnienie (art.43), ani procedura marży
                (art.119).</field>
        </record>

    </data>
</odoo>
