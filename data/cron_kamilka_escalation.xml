<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Ustawa Kamilka 2024 — 5-minute escalation cron.
             If the primary kierownik (event.event.user_id) has not
             acknowledged a kamilka-severity incident SMS within 5 min,
             dispatch SMS to the deputy_kierownik_id (preferred) or
             any organizator (fallback).

             Legal: vital-interest override (RODO art. 6.1.d) +
             Art. 162 KK criminal liability for failure to render aid. -->
        <record id="cron_kamilka_escalation" model="ir.cron">
            <field name="name">CampScout: Ustawa Kamilka SMS escalation (5min)</field>
            <field name="model_id" ref="model_camp_incident_report"/>
            <field name="state">code</field>
            <field name="code">model._cron_kamilka_escalate()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
            <field name="user_id" ref="base.user_root"/>
        </record>

    </data>
</odoo>
