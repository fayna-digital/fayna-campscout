<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
          Feature flag per CAMPSCOUT_MASTER_TZ.md §4.6 ЗАКОН + §2 Strangler Fig.
          Default False keeps the module inert so any prior behaviour owning
          the same domain keeps working until the intentional flip.
        -->
        <record id="ir_config_parameter_fayna_camp_portal_active" model="ir.config_parameter">
            <field name="key">fayna_camp_portal.active</field>
            <field name="value">False</field>
        </record>

        <!--
          Wychowawca / kierownik staff-broadcast SMS — cost guard parameters.
          Defaults align with PL market pricing 2026 (TurboSMS PL ≈ 0.05 PLN/segment).
        -->
        <record id="cfg_sms_wychowawca_limit" model="ir.config_parameter">
            <field name="key">fayna_camp_portal.sms_wychowawca_monthly_limit</field>
            <field name="value">100</field>
        </record>
        <record id="cfg_sms_kierownik_limit" model="ir.config_parameter">
            <field name="key">fayna_camp_portal.sms_kierownik_monthly_limit</field>
            <field name="value">300</field>
        </record>
        <record id="cfg_sms_cost_per_segment" model="ir.config_parameter">
            <field name="key">fayna_camp_portal.sms_cost_per_segment_pln</field>
            <field name="value">0.05</field>
        </record>

        <!-- R12: дефолтні ставки кадри за турнус (PLN) для майстра табору і
             автоштату. 0 = СВІДОМО не вигадані — організатор задає реальні
             у Налаштуваннях (ir.config_parameter) або в самому майстрі. -->
        <record id="cfg_salary_wychowawca_default" model="ir.config_parameter">
            <field name="key">fayna_camp_portal.salary_wychowawca_default</field>
            <field name="value">0</field>
        </record>
        <record id="cfg_salary_kierownik_default" model="ir.config_parameter">
            <field name="key">fayna_camp_portal.salary_kierownik_default</field>
            <field name="value">0</field>
        </record>

    </data>
</odoo>
