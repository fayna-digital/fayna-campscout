<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- ═══════════════════════════════════════════════════════════════
             Module category
        ═══════════════════════════════════════════════════════════════ -->

        <record id="module_category_fayna_camp_portal" model="ir.module.category">
            <field name="name">Fayna CampScout</field>
            <field name="description">Roles for camp management: medical, kierownik, emergency, nutrition, admin.</field>
            <field name="sequence">25</field>
        </record>

        <!-- ═══════════════════════════════════════════════════════════════
             Medical Officer — RODO Art.9 special-category health data.
             Grants read/write access to medical fields on camp.participant
             (allergies, medications, chronic_conditions, doctor_notes).
             Only camp medical personnel should be assigned this group.
        ═══════════════════════════════════════════════════════════════ -->

        <record id="group_medical_officer" model="res.groups">
            <field name="name">Camp Medical Officer</field>
            <field name="category_id" ref="module_category_fayna_camp_portal"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">
                Medical officer — read/write access to RODO Art.9 special-category
                health fields: allergies, medications, chronic_conditions, doctor_notes
                on camp.participant. Requires signed DPA with organizer.
            </field>
        </record>

        <!-- ═══════════════════════════════════════════════════════════════
             Camp Kierownik — shift director / camp leader.
             Can create/edit daily reports (own),
             and view qualification cards of their own shift participants.
        ═══════════════════════════════════════════════════════════════ -->

        <record id="group_camp_kierownik" model="res.groups">
            <field name="name">Camp Kierownik</field>
            <field name="category_id" ref="module_category_fayna_camp_portal"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">
                Kierownik (camp shift director) — can create/edit
                camp.daily.report, camp.staff entries. Cannot approve Załącznik 9
                (that requires group_fayna_camp_manager).
            </field>
        </record>

        <!-- Camp Leader ЗЛИТО в Kierownik (рішення власника 2026-06-24): дубль
             однакової назви. Право sign/clear-auto-refusal перенесено в
             group_camp_kierownik. Leader-група прибрана (0 користувачів). -->

        <!-- ═══════════════════════════════════════════════════════════════
             Camp HR Manager — certification record management.
             Can add/edit staff certificates (KRK, RPS, course certs).
             Required by Rozp. MEN 2016 §4 for verified cert management.
        ═══════════════════════════════════════════════════════════════ -->

        <record id="group_camp_hr" model="res.groups">
            <field name="name">Camp HR Manager</field>
            <field name="category_id" ref="module_category_fayna_camp_portal"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">
                Camp HR manager — can add and edit staff certifications
                (KRK, RPS, course certs). PL law: Rozp. MEN 2016 §4.
            </field>
        </record>

        <!-- ═══════════════════════════════════════════════════════════════
             Camp Operations Admin — full ops access.
             Implied by group_fayna_camp_manager.
        ═══════════════════════════════════════════════════════════════ -->

        <record id="group_camp_admin" model="res.groups">
            <field name="name">Camp Operations Admin</field>
            <field name="category_id" ref="module_category_fayna_camp_portal"/>
            <field name="implied_ids" eval="[(4, ref('group_camp_kierownik'))]"/>
            <field name="comment">
                Camp operations admin — full access to camp.report including
                revert-to-draft on submitted reports. Implied by camp_manager.
            </field>
        </record>

        <!-- ═══════════════════════════════════════════════════════════════
             Camp Manager — full management access.
             Top-level camp group. Implies camp_admin → camp_kierownik.
             Can approve Program Wypoczynku (Załącznik 9).
        ═══════════════════════════════════════════════════════════════ -->

        <record id="group_fayna_camp_manager" model="res.groups">
            <field name="name">Camp Manager</field>
            <field name="category_id" ref="module_category_fayna_camp_portal"/>
            <field name="implied_ids" eval="[(4, ref('group_camp_admin'))]"/>
            <field name="comment">
                Camp manager — full access to Program Wypoczynku (Załącznik 9)
                including approve/submit workflow. Can override immutability
                where PL law permits (incident post-closure edits).
            </field>
        </record>

        <!-- ═══════════════════════════════════════════════════════════════
             Emergency Responder — first-responder access.
             Can create and update incident reports and action records.
             Cannot close or reopen closed incidents.
        ═══════════════════════════════════════════════════════════════ -->

        <record id="group_emergency_responder" model="res.groups">
            <field name="name">Camp Emergency Responder</field>
            <field name="category_id" ref="module_category_fayna_camp_portal"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">
                First-responder — can create/update camp.incident reports and
                camp.incident.action entries. Cannot close or reopen incidents.
                Required by BP-006 SLA (10s first action trigger).
            </field>
        </record>

        <!-- Emergency Manager — can close, reopen, and override incident state.
             Implied by fayna_camp_manager. -->

        <record id="group_emergency_manager" model="res.groups">
            <field name="name">Camp Emergency Manager</field>
            <field name="category_id" ref="module_category_fayna_camp_portal"/>
            <field name="implied_ids" eval="[(4, ref('group_emergency_responder'))]"/>
            <field name="comment">
                Emergency manager — full access to incident lifecycle including
                close, reopen, and override state. Immutable ledger enforcement
                applies post-close (BP-006, Ustawa Kamilka 2024).
            </field>
        </record>

        <!-- ═══════════════════════════════════════════════════════════════
             Nutrition Officer — dietary/allergen data management.
             Gates field-level access to RODO Art.9 dietary fields.
        ═══════════════════════════════════════════════════════════════ -->

        <record id="group_nutrition_officer" model="res.groups">
            <field name="name">Camp Nutrition Officer</field>
            <field name="category_id" ref="module_category_fayna_camp_portal"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">
                Nutrition officer — read/write access to dietary and allergen data
                on camp.diet.profile (RODO Art.9 special-category data).
                EU Regulation 1169/2011 (14 major allergens).
            </field>
        </record>

        <!-- ═══════════════════════════════════════════════════════════════
             NEW ROLES (TZ §5.1 — 6-role design 2026-04-30)
             Sales / Wychowawca / Instructor / Camp Admin (top-level)
        ═══════════════════════════════════════════════════════════════ -->

        <!-- 💼 Sales Manager — каталог, ціни, продажі, маркетинг -->
        <record id="group_camp_sales" model="res.groups">
            <field name="name">Camp Sales Manager</field>
            <field name="category_id" ref="module_category_fayna_camp_portal"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">
                Sales/marketing manager — catalog, prices, sale.order, support
                requests, marketing reports, public stories. NO access to medical
                data, kuratorium, dziennik, daily reports, incidents.
            </field>
        </record>

        <!-- 🧑‍🏫 Wychowawca — counselor, group leader -->
        <record id="group_camp_wychowawca" model="res.groups">
            <field name="name">Camp Wychowawca (Counselor)</field>
            <field name="category_id" ref="module_category_fayna_camp_portal"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">
                Wychowawca — runs activities for own group of children. Sees own
                group only via record rule camp.staff.event_id == self. Sees
                allergies + emergency_contact (children) but NOT medications/
                doctor_notes. Załącznik 5 MEN dziennik signing rights.
            </field>
        </record>

        <!-- 📋 Candidate — applicant for a wychowawca/instructor position.
             Implied: base.group_portal (NOT group_user — no backend access).
             Can see own staff record (draft), upload own certs, track own application.
             §13 RSPTS gate stays intact: candidate cannot confirm own camp.staff. -->
        <record id="group_camp_candidate" model="res.groups">
            <field name="name">Camp Candidate (Applicant)</field>
            <field name="category_id" ref="module_category_fayna_camp_portal"/>
            <field name="implied_ids" eval="[(4, ref('base.group_portal'))]"/>
            <field name="comment">
                Portal-only group for wychowawca/instructor applicants. Sees own
                camp.staff (draft) + own camp.staff.cert + own application via
                record rules. No access to camp.participant (children) whatsoever.
                §13 RSPTS gate (operations.py:217) blocks any confirmation attempt.
            </field>
        </record>

        <!-- 🎯 Instructor — activity specialist -->
        <record id="group_camp_instructor" model="res.groups">
            <field name="name">Camp Instructor (Activity Specialist)</field>
            <field name="category_id" ref="module_category_fayna_camp_portal"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">
                Instructor — specialist for one or more activities (swimming,
                climbing, archery). Sees own activities via record rule
                camp.activity.responsible_id == self. Sees only attendees with
                relevant medical info (e.g., asthma for running).
            </field>
        </record>

        <!-- 🔴 Organizator Wypoczynku — TOP-LEVEL legal entity per PL law.
             Per Rozp. MEN 30.03.2016 § 2.1: organizator = juridical person
             (fundacja, organizacja skautowa, sp. z o.o. etc.) registered with
             Kuratorium Oświaty, holding the legal right to organize camps.
             This role lands on /admin/dashboard and can /admin/as-{role}
             impersonate any other role for support/inspection. -->
        <record id="group_camp_organizator" model="res.groups">
            <field name="name">Organizator Wypoczynku (top-level)</field>
            <field name="category_id" ref="module_category_fayna_camp_portal"/>
            <field name="implied_ids" eval="[
                (4, ref('base.group_system')),
                (4, ref('event.group_event_manager')),
                (4, ref('group_fayna_camp_manager')),
                (4, ref('group_emergency_manager')),
                (4, ref('group_nutrition_officer')),
                (4, ref('group_medical_officer')),
                (4, ref('group_camp_hr')),
                (4, ref('group_camp_sales'))
            ]"/>
            <field name="comment">
                Organizator Wypoczynku per PL law (Rozp. MEN 30.03.2016 §2.1).
                Legal person/entity (foundation, scout org, company) registered
                with Kuratorium Oświaty. Bypasses all record rules (via
                base.group_system), lands on /admin/dashboard, can
                /admin/as-{role} impersonate any role. Each impersonation
                logged in camp.admin.access.log (RODO art.30, 7-year retention).
            </field>
        </record>


        <!-- Księgowa / Finanse — кабінет №7 (sprint 2026-06-10, TZ §5).
             Read-only фінансові дашборди/звіти + експорт; бюджети редагує
             organizator/admin. Зарплатні рядки бачить лише ця група+admin
             (record rule is_salary у rules_budget). -->
        <record id="group_camp_finance" model="res.groups">
            <field name="name">Camp Finance (Księgowa)</field>
            <field name="category_id" ref="module_category_fayna_camp_portal"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">
                Finance cabinet — budgets (BEP, marża VAT art.119 vs business
                margin incl. advertising), zestawienia for the accountant.
            </field>
        </record>

        <!-- ═══════════════════════════════════════════════════════════════
             RODO Art.9 Medical Access — field-level gate (§6j / §6l-final)
             TZ §5: field-level (live forms) protection for health/allergy/
             medications/diet (special-category data under RODO art. 9).

             WHO gets this group (§6l final table — ✅ art.9):
               * group_medical_officer  — medic (all camp)
               * group_camp_kierownik   — camp director (whole shift)
               * group_camp_wychowawca  — counselor (own group via record-rule)
               * group_camp_sales       — sales/manager (own clients, QA role)
               * base.group_portal      — parent (own child via record-rule)

             WHO does NOT get this group (§6l — ❌ art.9):
               * group_camp_finance     — bookkeeper: financial data only
               * group_camp_hr          — cert admin: no medical data
               * group_camp_instructor  — sees safety flags only (not full art.9)
               * group_camp_candidate   — applicant: no children access
               * any user without the above groups

             Note: group_camp_organizator already implies group_medical_officer
             (via groups.xml implied chain), so organizator inherits this group
             automatically through group_medical_officer membership.

             Implementation: all art.9 fields on camp.participant carry
               groups="fayna_camp_portal.group_medical_access"
             Attachment-level: record rule on ir.attachment enforces the same
             boundary for karta-PDFs (§6j — PDF ≠ field-security bypass).
        ═══════════════════════════════════════════════════════════════ -->

        <record id="group_medical_access" model="res.groups">
            <field name="name">Camp Medical Access (RODO Art.9)</field>
            <field name="category_id" ref="module_category_fayna_camp_portal"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">
                RODO Art.9 field-level gate — read/write access to special-category
                health data on camp.participant (allergies, medications,
                chronic_conditions, doctor_notes, vaccination fields, psycho-behavioral
                flags, all pkt-9 wzor-2026 booleans, sections III/V health fields).

                Granted via implied_ids on: group_medical_officer, group_camp_kierownik,
                group_camp_wychowawca, group_camp_sales.
                Portal parents also receive it directly (implied by base.group_portal
                on those groups); access scope is limited by the portal record rule
                (own children only — rule_portal_participant_own_children).

                NOT granted to: group_camp_finance, group_camp_hr, group_camp_instructor,
                group_camp_candidate — those roles never see raw art.9 data.
            </field>
        </record>

        <!-- ─── Wire group_medical_access into each qualifying role ──────
             Update implied_ids AFTER group_medical_access is defined above.
             These records patch the existing role groups to also imply the
             medical-access gate, completing the two-way association.
             noupdate=0 (outer data tag) so upgrades always re-apply.
        ──────────────────────────────────────────────────────────────── -->

        <record id="group_medical_officer" model="res.groups">
            <field name="implied_ids" eval="[
                (4, ref('base.group_user')),
                (4, ref('group_medical_access'))
            ]"/>
        </record>

        <record id="group_camp_kierownik" model="res.groups">
            <field name="implied_ids" eval="[
                (4, ref('base.group_user')),
                (4, ref('group_medical_access'))
            ]"/>
        </record>

        <record id="group_camp_wychowawca" model="res.groups">
            <field name="implied_ids" eval="[
                (4, ref('base.group_user')),
                (4, ref('group_medical_access'))
            ]"/>
        </record>

        <record id="group_camp_sales" model="res.groups">
            <field name="implied_ids" eval="[
                (4, ref('base.group_user')),
                (4, ref('group_medical_access'))
            ]"/>
        </record>

    </data>
</odoo>
