<?xml version="1.0" encoding="utf-8"?>
<!-- FRAGMENT — to be merged into security/record_rules.xml (inside <data noupdate="1">)
     during the integration pass. TZ_SPRINT_2026-06-10 §4:
       regulamin: kierownik rw own event, wychowawca/instructor read own event,
                  ack write only on own (sign via method);
       teczka:    kierownik read own, organizator all (group_system bypass).
     Domains follow the existing kierownik convention:
       '|', event.user_id == user, event.staff_ids.user_id == user
     (see rule_journal_kierownik_own_camp). -->
<odoo>
    <data noupdate="1">

        <!-- ─── camp.regulamin ────────────────────────────────────────── -->

        <!-- Kierownik READS regulaminy of own camps + organizer templates -->
        <record id="rule_regulamin_kierownik_read" model="ir.rule">
            <field name="name">Kierownik: read regulaminy of own camp + templates</field>
            <field name="model_id" ref="model_camp_regulamin"/>
            <field name="groups" eval="[(4, ref('group_camp_kierownik'))]"/>
            <field name="domain_force">['|', ('event_id', '=', False), '|', ('event_id.user_id', '=', user.id), ('event_id.staff_ids.user_id', '=', user.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Kierownik WRITES/CREATES only event-bound regulaminy of own camp
             (organizer-wide templates stay read-only for kierownik) -->
        <record id="rule_regulamin_kierownik_write_own" model="ir.rule">
            <field name="name">Kierownik: write regulaminy of own camp only</field>
            <field name="model_id" ref="model_camp_regulamin"/>
            <field name="groups" eval="[(4, ref('group_camp_kierownik'))]"/>
            <field name="domain_force">['|', ('event_id.user_id', '=', user.id), ('event_id.staff_ids.user_id', '=', user.id)]</field>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Wychowawca / Instructor: read regulaminy of own event + templates -->
        <record id="rule_regulamin_staff_read_own_event" model="ir.rule">
            <field name="name">Wychowawca/Instructor: read regulaminy of own event</field>
            <field name="model_id" ref="model_camp_regulamin"/>
            <field name="groups" eval="[(4, ref('group_camp_wychowawca')), (4, ref('group_camp_instructor'))]"/>
            <field name="domain_force">['|', ('event_id', '=', False), ('event_id.staff_ids.user_id', '=', user.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- ─── camp.regulamin.ack ────────────────────────────────────── -->

        <!-- Kierownik: full management of acks of own camp (generate/delete) -->
        <record id="rule_regulamin_ack_kierownik_own_camp" model="ir.rule">
            <field name="name">Kierownik: acks of own camp</field>
            <field name="model_id" ref="model_camp_regulamin_ack"/>
            <field name="groups" eval="[(4, ref('group_camp_kierownik'))]"/>
            <field name="domain_force">['|', ('event_id.user_id', '=', user.id), ('event_id.staff_ids.user_id', '=', user.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Wychowawca / Instructor: read acks of own event (kto podpisał) -->
        <record id="rule_regulamin_ack_staff_read_own_event" model="ir.rule">
            <field name="name">Wychowawca/Instructor: read acks of own event</field>
            <field name="model_id" ref="model_camp_regulamin_ack"/>
            <field name="groups" eval="[(4, ref('group_camp_wychowawca')), (4, ref('group_camp_instructor'))]"/>
            <field name="domain_force">[('event_id.staff_ids.user_id', '=', user.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Wychowawca / Instructor: WRITE only own ack — i.e. signing via
             action_sign(); the model-level write()-gate additionally enforces
             user_id == env.user and post-sign freeze. -->
        <record id="rule_regulamin_ack_staff_write_own" model="ir.rule">
            <field name="name">Wychowawca/Instructor: sign only own ack</field>
            <field name="model_id" ref="model_camp_regulamin_ack"/>
            <field name="groups" eval="[(4, ref('group_camp_wychowawca')), (4, ref('group_camp_instructor'))]"/>
            <field name="domain_force">[('staff_id.user_id', '=', user.id)]</field>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- ─── camp.teczka.ko ────────────────────────────────────────── -->

        <!-- Kierownik: read teczka of own camp. Organizator sees all
             (bypasses rules via base.group_system implied). -->
        <record id="rule_teczka_ko_kierownik_own_camp" model="ir.rule">
            <field name="name">Kierownik: Teczka KO of own camp</field>
            <field name="model_id" ref="model_camp_teczka_ko"/>
            <field name="groups" eval="[(4, ref('group_camp_kierownik'))]"/>
            <field name="domain_force">['|', ('event_id.user_id', '=', user.id), ('event_id.staff_ids.user_id', '=', user.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

    </data>
</odoo>
