<?xml version="1.0" encoding="utf-8"?>
<!-- FRAGMENT — merge the records below into security/record_rules.xml.
     camp.budget / camp.budget.line — TZ §5: «Kierownik бачить бюджет свого
     табору read-only БЕЗ зарплат».

     ⚠️ Залежить від групи fayna_camp_portal.group_camp_finance, яку інтегратор
     додає в security/groups.xml. Finance/organizator/admin НЕ мають record rule
     на цих моделях → бачать усе (global ACL).

     ⚠️ record_rules.xml = <data noupdate="1">: на staging, де модуль уже
     встановлено, нові правила підхопляться при -u (нові записи створюються,
     noupdate блокує лише UPDATE існуючих). -->
<odoo>
    <data noupdate="1">

        <!-- ─── camp.budget — kierownik: read-only, лише свій табір ────── -->
        <!-- Pattern: rule_camp_group_kierownik_own — kierownik прив'язаний
             до турнусу через event.user_id АБО camp.staff (staff_ids). -->
        <record id="rule_camp_budget_kierownik_own" model="ir.rule">
            <field name="name">Kierownik: budget of own camp (read-only)</field>
            <field name="model_id" ref="model_camp_budget"/>
            <field name="groups" eval="[(4, ref('group_camp_kierownik'))]"/>
            <field name="domain_force">['|', ('event_id.user_id', '=', user.id), ('event_id.staff_ids.user_id', '=', user.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- ─── camp.budget.line — kierownik: свій табір, БЕЗ wynagrodzeń ─ -->
        <!-- Field-level groups на amount неможливий (число — або видно, або
             ні), тому ховаємо ЦІЛІ рядки категорій kadra: category_id.is_salary
             = True (camp.budget.category, data/budget_categories.xml →
             budget_categ_kadra). Сумарні поля бюджету (total_fixed, marże)
             kierownik усе одно бачить агреговано — це прийнято в TZ §5
             («read-only без зарплат» = без ДЕТАЛІЗАЦІЇ wynagrodzeń). -->
        <record id="rule_camp_budget_line_kierownik_own_no_salary" model="ir.rule">
            <field name="name">Kierownik: budget lines of own camp, salary lines hidden</field>
            <field name="model_id" ref="model_camp_budget_line"/>
            <field name="groups" eval="[(4, ref('group_camp_kierownik'))]"/>
            <field name="domain_force">['&amp;', ('category_id.is_salary', '=', False), '|', ('budget_id.event_id.user_id', '=', user.id), ('budget_id.event_id.staff_ids.user_id', '=', user.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

    </data>
</odoo>
