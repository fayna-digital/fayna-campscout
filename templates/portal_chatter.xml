<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!--
    Portal chatter integration — adds the standard Odoo 17
    `portal.message_thread` block ("Historia komunikacji") to four
    parent-portal pages. Staff posts internal-flagged notes; parents
    only see public messages (`is_internal=False`).

    This file is *additive* — it does not modify portal_templates.xml.
    Detail templates that did not previously exist (`portal_participants_detail`,
    `portal_stories_detail`, `portal_support_detail`) are introduced here as
    standalone templates so the matching `/my/<…>/<id>` controller routes
    (added separately) can render them.

    For `/my/loyalty` (single record per partner), chatter is xpath-injected
    into the existing `portal_loyalty` template.
-->

<!-- ============================================================================
     /my/participants/<id> — qualification card detail + chatter
     ============================================================================ -->

<template id="portal_participants_detail" name="Participant Detail">
    <t t-call="portal.portal_layout">
        <t t-set="additional_title">Кваліфікаційна картка</t>

        <div class="cs-page">
            <div class="cs-page-back mb-3">
                <a href="/my/participants" class="cs-back-link">&#8592; До списку учасників</a>
            </div>

            <t t-if="participant">
                <div class="cs-page-header mb-4 cs-participant-detail">
                    <h2 class="cs-page-title" t-esc="participant.display_name"/>
                    <p class="cs-page-subtitle">
                        <t t-if="participant.qualification_signed">
                            <span class="badge bg-success">Картка підписана</span>
                        </t>
                        <t t-else="">
                            <span class="badge bg-warning text-dark">Картка не заповнена</span>
                        </t>
                    </p>
                </div>

                <!-- Тіло картки kwalifikacyjnej — секція I (read-only) + editable kontakty/special_needs + підпис -->
                <div class="cs-participant-card mb-4">

                    <!-- Помилка валідації з /submit (UserError/ValidationError) -->
                    <t t-if="error">
                        <div class="alert alert-danger" t-esc="error"/>
                    </t>

                    <!-- Секція I — дані з реєстрації (READ-ONLY, не редагуються батьком) -->
                    <div class="card mb-3 shadow-sm">
                        <div class="card-header"><strong>I. Dane uczestnika</strong></div>
                        <div class="card-body">
                            <div class="row g-2">
                                <div class="col-12 col-md-6">
                                    <small class="text-muted d-block">Imię</small>
                                    <span t-esc="participant.first_name or '—'"/>
                                </div>
                                <div class="col-12 col-md-6">
                                    <small class="text-muted d-block">Nazwisko</small>
                                    <span t-esc="participant.last_name or '—'"/>
                                </div>
                                <div class="col-12 col-md-6">
                                    <small class="text-muted d-block">Data urodzenia</small>
                                    <span t-esc="participant.birth_date and participant.birth_date.strftime('%d.%m.%Y') or '—'"/>
                                </div>
                            </div>
                            <p class="text-muted small mb-0 mt-2">
                                Te dane pochodzą z rejestracji. Aby je poprawić — skontaktuj się z koordynatorem.
                            </p>
                        </div>
                    </div>

                    <!-- ===== STAN 1: картка ще НЕ підписана → форма + canvas ===== -->
                    <t t-if="not participant.qualification_signed">

                        <!-- Editable-поля: kontakty alarmowe + potrzeby specjalne (POST → /submit) -->
                        <form t-attf-action="/my/participants/#{participant.id}/submit" method="post"
                              class="card mb-3 shadow-sm">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <div class="card-header"><strong>Kontakty alarmowe i potrzeby specjalne</strong></div>
                            <div class="card-body">
                                <div class="row g-3">
                                    <!-- Kontakt alarmowy 1 (wymagany do podpisu) -->
                                    <div class="col-12 col-md-4">
                                        <label class="form-label">Kontakt alarmowy 1 — imię i nazwisko *</label>
                                        <input type="text" name="emergency_contact_1_name" class="form-control"
                                               t-att-value="participant.emergency_contact_1_name or ''"/>
                                    </div>
                                    <div class="col-12 col-md-4">
                                        <label class="form-label">Telefon *</label>
                                        <input type="text" name="emergency_contact_1_phone" class="form-control"
                                               t-att-value="participant.emergency_contact_1_phone or ''"/>
                                    </div>
                                    <div class="col-12 col-md-4">
                                        <label class="form-label">Pokrewieństwo</label>
                                        <input type="text" name="emergency_contact_1_relation" class="form-control"
                                               t-att-value="participant.emergency_contact_1_relation or ''"/>
                                    </div>
                                    <!-- Kontakt alarmowy 2 (opcjonalny) -->
                                    <div class="col-12 col-md-4">
                                        <label class="form-label">Kontakt alarmowy 2 — imię i nazwisko</label>
                                        <input type="text" name="emergency_contact_2_name" class="form-control"
                                               t-att-value="participant.emergency_contact_2_name or ''"/>
                                    </div>
                                    <div class="col-12 col-md-4">
                                        <label class="form-label">Telefon</label>
                                        <input type="text" name="emergency_contact_2_phone" class="form-control"
                                               t-att-value="participant.emergency_contact_2_phone or ''"/>
                                    </div>
                                    <div class="col-12 col-md-4">
                                        <label class="form-label">Pokrewieństwo</label>
                                        <input type="text" name="emergency_contact_2_relation" class="form-control"
                                               t-att-value="participant.emergency_contact_2_relation or ''"/>
                                    </div>
                                    <!-- Potrzeby specjalne -->
                                    <div class="col-12">
                                        <label class="form-label">Potrzeby specjalne dziecka</label>
                                        <textarea name="special_needs" class="form-control" rows="3"
                                                  t-esc="participant.special_needs or ''"/>
                                    </div>
                                </div>
                            </div>
                            <div class="card-footer">
                                <button type="submit" class="btn btn-primary">Zapisz</button>
                            </div>
                        </form>

                        <!-- Signature pad (mobile-first canvas) — копія escort 1:1 -->
                        <div class="card mb-3 shadow-sm">
                            <div class="card-header"><strong>Podpis rodzica / opiekuna</strong></div>
                            <div class="card-body">
                                <p class="text-muted small">
                                    Podpisując kartę potwierdzasz poprawność danych. Po podpisie pól nie da się już zmienić.
                                </p>
                                <canvas id="participant_sign_pad" width="320" height="140"
                                        style="border:1px solid #ccc; touch-action:none; max-width:100%;"></canvas>
                                <div class="mt-2">
                                    <button type="button" class="btn btn-outline-secondary btn-sm" id="participant_sign_clear">Wyczyść</button>
                                    <button type="button" class="btn btn-success btn-sm" id="participant_sign_save"
                                            t-attf-data-participant-id="#{participant.id}">Podpisz kartę</button>
                                </div>
                            </div>
                        </div>
                    </t>

                    <!-- ===== STAN 2: картка ПІДПИСАНА → read-only зведення + PDF ===== -->
                    <t t-if="participant.qualification_signed">
                        <div class="alert alert-success">
                            Karta podpisana
                            <t t-if="participant.qualification_signed_date">
                                — <t t-esc="participant.qualification_signed_date.strftime('%d.%m.%Y %H:%M')"/>
                            </t>
                            <t t-if="participant.qualification_signed_by_name">
                                przez <t t-esc="participant.qualification_signed_by_name"/>
                            </t>
                        </div>

                        <div class="card mb-3 shadow-sm">
                            <div class="card-header"><strong>Kontakty alarmowe</strong></div>
                            <div class="card-body">
                                <div class="row g-2">
                                    <div class="col-12 col-md-6">
                                        <small class="text-muted d-block">Kontakt 1</small>
                                        <span t-esc="participant.emergency_contact_1_name or '—'"/>
                                        <span t-if="participant.emergency_contact_1_phone">, <t t-esc="participant.emergency_contact_1_phone"/></span>
                                    </div>
                                    <div class="col-12 col-md-6" t-if="participant.emergency_contact_2_name">
                                        <small class="text-muted d-block">Kontakt 2</small>
                                        <span t-esc="participant.emergency_contact_2_name"/>
                                        <span t-if="participant.emergency_contact_2_phone">, <t t-esc="participant.emergency_contact_2_phone"/></span>
                                    </div>
                                    <div class="col-12" t-if="participant.special_needs">
                                        <small class="text-muted d-block">Potrzeby specjalne</small>
                                        <span t-esc="participant.special_needs"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <a class="btn btn-outline-primary"
                           t-attf-href="/report/pdf/fayna_camp_portal.report_karta_kwalifikacyjna/#{participant.id}"
                           target="_blank">
                            Pobierz kartę (PDF)
                        </a>
                    </t>
                </div>

                <!-- Historia komunikacji -->
                <div class="cs-participant-chatter mt-4">
                    <h4 class="mb-3">Історія комунікації</h4>
                    <t t-call="portal.message_thread">
                        <t t-set="object" t-value="participant"/>
                        <t t-set="token" t-value="token or (participant.sudo().access_token if participant.sudo() else False)"/>
                        <t t-set="message_post_hash_token" t-value="participant.sudo()._portal_ensure_token()"/>
                        <t t-set="pid" t-value="user_id and user_id.partner_id and user_id.partner_id.id or False"/>
                    </t>
                </div>
            </t>
        </div>

        <!-- Canvas signature pad JS — копія escort 1:1 (touch+mouse, clear, toDataURL→JSON-RPC POST на /sign, reload на success) -->
        <script type="text/javascript">
            <![CDATA[
            (function () {
                var c = document.getElementById('participant_sign_pad');
                if (!c) { return; }
                var ctx = c.getContext('2d'), drawing = false;
                function pos(e) {
                    var r = c.getBoundingClientRect();
                    var t = (e.touches && e.touches[0]) || e;
                    return { x: t.clientX - r.left, y: t.clientY - r.top };
                }
                function start(e) { drawing = true; var p = pos(e); ctx.beginPath(); ctx.moveTo(p.x, p.y); e.preventDefault(); }
                function move(e) { if (!drawing) { return; } var p = pos(e); ctx.lineTo(p.x, p.y); ctx.stroke(); e.preventDefault(); }
                function end() { drawing = false; }
                c.addEventListener('mousedown', start); c.addEventListener('mousemove', move);
                c.addEventListener('mouseup', end); c.addEventListener('mouseleave', end);
                c.addEventListener('touchstart', start); c.addEventListener('touchmove', move);
                c.addEventListener('touchend', end);
                document.getElementById('participant_sign_clear').addEventListener('click', function () {
                    ctx.clearRect(0, 0, c.width, c.height);
                });
                document.getElementById('participant_sign_save').addEventListener('click', function () {
                    var id = this.getAttribute('data-participant-id');
                    var data = c.toDataURL('image/png');
                    fetch('/my/participants/' + id + '/sign', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ jsonrpc: '2.0', method: 'call', params: { signature: data } })
                    }).then(function (r) { return r.json(); }).then(function (res) {
                        if (res.result && res.result.success) { location.reload(); }
                        else { alert('Błąd: ' + ((res.result && res.result.error) || 'podpis')); }
                    });
                });
            })();
            ]]>
        </script>
    </t>
</template>


<!-- ============================================================================
     /my/stories/<id> — single story detail + chatter
     ============================================================================ -->

<template id="portal_stories_detail" name="Story Detail">
    <t t-call="portal.portal_layout">
        <t t-set="additional_title">Історія з табору</t>

        <div class="cs-page">
            <div class="cs-page-back mb-3">
                <a href="/my/stories" class="cs-back-link">&#8592; До списку історій</a>
            </div>

            <t t-if="story">
                <div class="cs-story-card cs-story-detail mb-4">
                    <div class="cs-story-head">
                        <div class="cs-story-meta">
                            <time class="cs-story-date" t-if="story.date">
                                <t t-esc="story.date.strftime('%d.%m.%Y')"/>
                            </time>
                            <span class="cs-story-type" t-attf-data-type="#{story.story_type}"
                                  t-esc="story.story_type"/>
                        </div>
                        <h3 class="cs-story-title" t-esc="story.title"/>
                    </div>
                    <div class="cs-story-body">
                        <div t-out="story.content"/>
                    </div>
                </div>

                <!--
                    Chatter on `camp.story` requires that model to inherit
                    `portal.mixin` (defined in the `fayna_camp_stories`
                    module). If it does not yet, this `<t t-call>` is wrapped
                    in `t-if="story._name and hasattr(story, '_portal_ensure_token')"`
                    so the page degrades gracefully without a 500.
                -->
                <t t-if="hasattr(story, '_portal_ensure_token')">
                    <div class="cs-story-chatter mt-4">
                        <h4 class="mb-3">Історія комунікації</h4>
                        <t t-call="portal.message_thread">
                            <t t-set="object" t-value="story"/>
                            <t t-set="token" t-value="token or False"/>
                            <t t-set="message_post_hash_token" t-value="story.sudo()._portal_ensure_token()"/>
                            <t t-set="pid" t-value="user_id and user_id.partner_id and user_id.partner_id.id or False"/>
                        </t>
                    </div>
                </t>
            </t>
        </div>
    </t>
</template>


<!-- ============================================================================
     /my/support/<id> — support request detail + chatter
     ============================================================================ -->

<template id="portal_support_detail" name="Support Request Detail">
    <t t-call="portal.portal_layout">
        <t t-set="additional_title">Звернення</t>

        <div class="cs-page">
            <div class="cs-page-back mb-3">
                <a href="/my/support" class="cs-back-link">&#8592; До списку звернень</a>
            </div>

            <t t-if="support">
                <div class="cs-page-header mb-4">
                    <h2 class="cs-page-title">
                        <t t-esc="support.name or 'Звернення'"/>
                    </h2>
                    <p class="cs-page-subtitle">
                        <span t-attf-class="badge bg-secondary">
                            <t t-esc="dict(support._fields['request_type'].selection).get(support.request_type, support.request_type or '')"/>
                        </span>
                        <span class="ms-2 text-muted" t-if="support.submission_date">
                            <t t-esc="support.submission_date.strftime('%d.%m.%Y %H:%M')"/>
                        </span>
                    </p>
                </div>

                <div class="cs-support-detail mb-4">
                    <div t-if="support.description" t-out="support.description"/>
                </div>

                <!-- Historia komunikacji -->
                <div class="cs-support-chatter mt-4">
                    <h4 class="mb-3">Історія комунікації</h4>
                    <t t-call="portal.message_thread">
                        <t t-set="object" t-value="support"/>
                        <t t-set="token" t-value="token or False"/>
                        <t t-set="message_post_hash_token" t-value="support.sudo()._portal_ensure_token()"/>
                        <t t-set="pid" t-value="user_id and user_id.partner_id and user_id.partner_id.id or False"/>
                    </t>
                </div>
            </t>
        </div>
    </t>
</template>


<!-- ============================================================================
     /my/loyalty — chatter on the parent's loyalty record
     ============================================================================ -->

<template id="portal_loyalty_chatter" inherit_id="fayna_camp_portal.portal_loyalty" priority="30">
    <xpath expr="//div[hasclass('cs-page')]" position="inside">
        <t t-if="loyalty">
            <div class="cs-loyalty-chatter mt-4">
                <h4 class="mb-3">Історія комунікації</h4>
                <t t-call="portal.message_thread">
                    <t t-set="object" t-value="loyalty"/>
                    <t t-set="token" t-value="token or False"/>
                    <t t-set="message_post_hash_token" t-value="loyalty.sudo()._portal_ensure_token()"/>
                    <t t-set="pid" t-value="user_id and user_id.partner_id and user_id.partner_id.id or False"/>
                </t>
            </div>
        </t>
    </xpath>
</template>


<!-- ============================================================================
     /my/transport — list of transport trips for parent's children
     ============================================================================ -->

<template id="portal_transport" name="My Transport">
    <t t-call="portal.portal_layout">
        <t t-set="additional_title">Трансфер</t>
        <div class="cs-page">
            <div class="cs-page-header mb-4">
                <h2 class="cs-page-title">Трансфер</h2>
                <p class="cs-page-subtitle text-muted">
                    Заплановані та виконані трансфери для ваших дітей.
                </p>
            </div>
            <t t-if="not transports">
                <div class="alert alert-info">
                    Трансфер ще не призначено. Зверніться до координатора табору.
                </div>
            </t>
            <t t-foreach="transports" t-as="transport">
                <a t-att-href="'/my/transport/%d' % transport.id" class="text-decoration-none text-reset">
                    <div class="card mb-3 shadow-sm">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <strong t-esc="transport.name"/>
                            <span t-attf-class="badge #{
                                'bg-success' if transport.state == 'completed' else
                                'bg-primary' if transport.state == 'confirmed' else
                                'bg-danger' if transport.state == 'cancelled' else
                                'bg-warning text-dark'}">
                                <t t-esc="dict(transport._fields['state'].selection).get(transport.state, transport.state)"/>
                            </span>
                        </div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-sm-6">
                                    <p class="mb-1"><strong>Звідки:</strong> <t t-esc="transport.departure_location"/></p>
                                    <p class="mb-1"><strong>Куди:</strong> <t t-esc="transport.arrival_location"/></p>
                                </div>
                                <div class="col-sm-6">
                                    <t t-if="transport.departure_datetime">
                                        <p class="mb-1"><strong>Відправлення:</strong> <t t-esc="transport.departure_datetime"/></p>
                                    </t>
                                    <t t-if="transport.arrival_datetime">
                                        <p class="mb-1"><strong>Прибуття:</strong> <t t-esc="transport.arrival_datetime"/></p>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </div>
                </a>
            </t>
        </div>
    </t>
</template>

<template id="portal_transport_detail" name="Transport Trip Detail">
    <t t-call="portal.portal_layout">
        <t t-set="additional_title">Трансфер</t>
        <div class="cs-page">
            <div class="cs-page-back mb-3">
                <a href="/my/transport" class="cs-back-link">&#8592; До списку</a>
            </div>
            <t t-if="transport">
                <div class="cs-page-header mb-4">
                    <h2 class="cs-page-title" t-esc="transport.name"/>
                </div>
                <div class="card mb-3 shadow-sm">
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-sm-6">
                                <p class="mb-1"><strong>Звідки:</strong> <t t-esc="transport.departure_location"/></p>
                                <p class="mb-1"><strong>Куди:</strong> <t t-esc="transport.arrival_location"/></p>
                                <p class="mb-1"><strong>Відправлення:</strong> <t t-esc="transport.departure_datetime"/></p>
                                <p class="mb-1" t-if="transport.arrival_datetime">
                                    <strong>Прибуття:</strong> <t t-esc="transport.arrival_datetime"/>
                                </p>
                            </div>
                            <div class="col-sm-6">
                                <p class="mb-1" t-if="transport.vehicle_type">
                                    <strong>Транспорт:</strong>
                                    <t t-esc="dict(transport._fields['vehicle_type'].selection).get(transport.vehicle_type, transport.vehicle_type)"/>
                                </p>
                                <p class="mb-1" t-if="transport.transport_company">
                                    <strong>Перевізник:</strong> <t t-esc="transport.transport_company"/>
                                </p>
                                <p class="mb-1" t-if="transport.driver_name">
                                    <strong>Водій:</strong> <t t-esc="transport.driver_name"/>
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
                <t t-call="portal.message_thread">
                    <t t-set="object" t-value="transport"/>
                </t>
            </t>
        </div>
    </t>
</template>


</odoo>
