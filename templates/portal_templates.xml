<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!-- ============================================================================
     Home hero — children strip + active/upcoming camps + nav row
     Replaces the 3 separate docs_entry cards with one structured block.
     ============================================================================ -->

<!-- Rename "My account" → "Panel Klienta" / "Кабінет батьків" per legal
     documents (regulamin-panelu-klienta.html). Match by structure, not
     text — the 'My account' string is already translated at render
     time in some locales, so text() XPath would fail. -->
<!-- ============================================================================
     Impersonation banner on the /my portal.
     [ПРИПУЩЕННЯ] request.session in the website/portal QWeb context is not a
     reliable way to read impersonator_uid across Odoo 17 render paths, so we
     fetch the existing JSON route (/admin/impersonation-status) from a tiny
     inline script and reveal the banner only when impersonating. Minimal,
     no model/session coupling. The banner links to /admin/stop-impersonation.
     Injected into portal.frontend_layout so it shows on every /my page.
     ============================================================================ -->
<template id="portal_impersonation_banner_campscout" inherit_id="portal.frontend_layout" priority="25">
    <xpath expr="//div[@id='wrapwrap']" position="inside">
        <div id="cs_impersonation_banner" class="alert alert-danger text-center mb-0 d-none"
             role="alert" style="border-radius:0;position:sticky;top:0;z-index:1080;">
            <i class="fa fa-user-secret me-1"/>
            <span id="cs_impersonation_text">Ви переглядаєте кабінет в режимі імперсонації.</span>
            <a href="/admin/stop-impersonation" class="alert-link ms-2 fw-bold">
                Повернутися до адміністратора →
            </a>
        </div>
        <script type="text/javascript">
            (function () {
                fetch("/admin/impersonation-status", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ jsonrpc: "2.0", method: "call", params: {} }),
                })
                    .then(function (r) { return r.json(); })
                    .then(function (data) {
                        var res = data &amp;&amp; data.result;
                        if (res &amp;&amp; res.impersonating) {
                            var box = document.getElementById("cs_impersonation_banner");
                            var txt = document.getElementById("cs_impersonation_text");
                            if (txt) {
                                txt.textContent =
                                    "Ви переглядаєте кабінет як " + (res.current_name || "") +
                                    " (адмін: " + (res.admin_name || "") + ").";
                            }
                            if (box) { box.classList.remove("d-none"); }
                        }
                    })
                    .catch(function () { /* best-effort; stay hidden on error */ });
            })();
        </script>
    </xpath>
</template>

<!-- Role-aware cabinet title (G1/G0, TZ §G 2026-06-24): the «Кабінет батьків»
     heading must reflect WHO is logged in. A wychowawca/kierownik/instructor
     landing on a portal page must not read «Кабінет батьків». We branch on the
     user's CampScout role groups; parent (portal-only) keeps the default. -->
<template id="portal_layout_title_campscout" inherit_id="portal.portal_layout" priority="25">
    <xpath expr="//div[hasclass('wrapper')]/h3[hasclass('my-3')]" position="replace">
        <h3 class="my-3">
            <t t-if="user_id.has_group('fayna_camp_portal.group_camp_organizator')">Panel organizatora</t>
            <t t-elif="user_id.has_group('fayna_camp_portal.group_camp_kierownik')">Panel kierownika obozu</t>
            <t t-elif="user_id.has_group('fayna_camp_portal.group_camp_wychowawca')">Panel wychowawcy</t>
            <t t-elif="user_id.has_group('fayna_camp_portal.group_camp_instructor')">Panel instruktora</t>
            <t t-elif="user_id.has_group('fayna_camp_portal.group_camp_finance')">Panel księgowego</t>
            <t t-else="">Panel rodzica</t>
        </h3>
    </xpath>
</template>

<template id="portal_my_home_campscout_hero" inherit_id="portal.portal_my_home" name="CampScout Hero (children + camps)" priority="25">
    <!-- For portal-only parents: tag the root container so CSS hides the
         standard category rows (Orders/Invoices/Security). We don't touch
         .o_portal_docs or the spinner — Odoo JS keeps working. -->
    <xpath expr="//div[hasclass('o_portal_my_home')]" position="attributes">
        <attribute name="t-att-data-cs-parent-only">1 if cs_parent_only else 0</attribute>
    </xpath>
    <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
        <t t-if="cs_has_hero">
            <div class="cs-hero mb-4">

                <!-- Active camp banner (show only if any child is currently at a camp) -->
                <t t-if="cs_active_regs">
                    <div class="alert alert-success cs-active-camp mb-3" role="alert">
                        <t t-foreach="cs_active_regs" t-as="reg">
                            <div class="d-flex align-items-center">
                                <div class="flex-grow-1">
                                    <strong>
                                        <t t-if="reg.participant_id" t-esc="reg.participant_id.display_name"/>
                                        <t t-else="">Twoje dziecko</t>
                                    </strong>
                                    jest teraz na obozie
                                    <strong t-esc="reg.event_id.name"/>.
                                    <br/>
                                    <small class="text-muted">
                                        Powrót: <t t-esc="reg.event_id.date_end.strftime('%d.%m.%Y')"/>
                                    </small>
                                </div>
                            </div>
                        </t>
                    </div>
                </t>

                <!-- Children strip -->
                <div class="cs-children-strip mb-3">
                    <h5 class="mb-2">Twoje dzieci</h5>
                    <div class="row g-2">
                        <t t-foreach="cs_participants" t-as="child">
                            <div class="col-md-4 col-sm-6">
                                <a t-attf-href="/my/participants/#{child.id}" class="d-block text-decoration-none text-reset">
                                    <div class="card h-100 cs-child-card">
                                        <div class="card-body py-2 px-3 d-flex align-items-center gap-3">
                                            <!-- Avatar slot: real image when available, gender emoji fallback.
                                                 Source image comes from camp.day.photo tagging in Phase 5 (§2.7.6).
                                                 Until then, shows boy/girl/neutral child emoji. -->
                                            <div class="cs-child-avatar">
                                                <t t-if="child.image_128">
                                                    <img t-attf-src="/web/image/camp.participant/#{child.id}/image_128"
                                                         t-attf-alt="#{child.display_name}"/>
                                                </t>
                                                <t t-else="">
                                                    <span class="cs-child-emoji" t-attf-data-avatar="#{child.avatar_type or 'neutral'}">
                                                        <t t-if="child.avatar_type == 'girl'">👧</t>
                                                        <t t-elif="child.avatar_type == 'boy'">👦</t>
                                                        <t t-else="">🧒</t>
                                                    </span>
                                                </t>
                                            </div>
                                            <div class="flex-grow-1 min-w-0">
                                                <div class="fw-semibold text-truncate" t-esc="child.display_name"/>
                                                <small class="text-muted">
                                                    <t t-if="child.birth_date">
                                                        <t t-esc="(cs_today - child.birth_date).days // 365"/>
                                                        lat
                                                    </t>
                                                </small>
                                            </div>
                                        </div>
                                    </div>
                                </a>
                            </div>
                        </t>
                        <!-- Always-visible CTA: add another child. Sits in the
                             same grid as existing children so the «family
                             grows here» metaphor stays intact. -->
                        <div class="col-md-4 col-sm-6">
                            <!-- No self-service participant-create flow exists in this module:
                                 a child is created during booking. Open the booking modal
                                 instead of the dead /my/participants/new route. -->
                            <a href="#" data-bs-toggle="modal" data-bs-target="#csBookCampModal"
                               class="d-block text-decoration-none text-reset">
                                <div class="card h-100 cs-child-card cs-child-card-add">
                                    <div class="card-body py-2 px-3 d-flex align-items-center gap-3">
                                        <div class="cs-child-avatar">
                                            <span class="cs-child-emoji" data-gender="add">➕</span>
                                        </div>
                                        <div class="flex-grow-1 min-w-0">
                                            <div class="fw-semibold">Dodaj dziecko</div>
                                            <small class="text-muted">Przez rezerwację obozu</small>
                                        </div>
                                    </div>
                                </div>
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Upcoming camps -->
                <t t-if="cs_upcoming_regs">
                    <div class="cs-upcoming mb-3">
                        <h6 class="mb-2 text-muted">Najbliższe obozy</h6>
                        <ul class="list-unstyled mb-0">
                            <t t-foreach="cs_upcoming_regs" t-as="reg">
                                <li class="mb-1">
                                    <span class="badge bg-light text-dark me-2">
                                        <t t-esc="reg.event_id.date_begin.strftime('%d.%m')"/>
                                    </span>
                                    <t t-esc="reg.event_id.name"/>
                                    <t t-if="reg.participant_id">
                                        — <span class="text-muted" t-esc="reg.participant_id.display_name"/>
                                    </t>
                                </li>
                            </t>
                        </ul>
                    </div>
                </t>

                <!-- ============================================================
                     Nav blocks — kabinet RODZICA (PL).
                     Główne kafelki pokazują encje OBOZU językiem rodzica
                     (recognition-not-recall), nie metaforę sklepu. Standardowe
                     karty Odoo (Zamówienia / Faktury / Bezpieczeństwo) są
                     ukryte dla rodzica przez CSS [data-cs-parent-only].
                     Ten sam styl kart co siatka /my/documents.
                     ============================================================ -->
                <div class="cs-doc-grid mt-4">
                    <!-- Cztery główne encje obozu dla rodzica -->
                    <div class="row g-3">
                        <div class="col-md-6">
                            <!-- Karta dziecka — dane + karta kwalifikacyjna.
                                 Route /my/participants (verified controllers/portal.py). -->
                            <a href="/my/participants" class="cs-doc-card cs-doc-card-accent">
                                <span class="cs-doc-icon">🧒</span>
                                <div class="cs-doc-body">
                                    <h5 class="cs-doc-title">Karta dziecka</h5>
                                    <p class="cs-doc-desc">Dane dziecka i karta kwalifikacyjna do podpisu</p>
                                    <span class="cs-doc-cta">Otwórz →</span>
                                </div>
                            </a>
                        </div>
                        <div class="col-md-6">
                            <!-- Płatności i faktury — standardowy portal Odoo
                                 account (/my/invoices, moduł zależy od `account`). -->
                            <a href="/my/invoices" class="cs-doc-card">
                                <span class="cs-doc-icon">💳</span>
                                <div class="cs-doc-body">
                                    <h5 class="cs-doc-title">Płatności i faktury</h5>
                                    <p class="cs-doc-desc">Rachunki za obóz, opłaty i zwroty</p>
                                    <span class="cs-doc-cta">Zobacz →</span>
                                </div>
                            </a>
                        </div>
                        <div class="col-md-6">
                            <!-- Wiadomości — czat z kadrą obozu.
                                 Route /my/support (camp.support.request + mail.thread). -->
                            <a href="/my/support" class="cs-doc-card">
                                <span class="cs-doc-icon">💬</span>
                                <div class="cs-doc-body">
                                    <h5 class="cs-doc-title">Wiadomości</h5>
                                    <p class="cs-doc-desc">Pisz do kadry obozu i śledź odpowiedzi</p>
                                    <span class="cs-doc-cta">Napisz →</span>
                                </div>
                            </a>
                        </div>
                        <div class="col-md-6">
                            <!-- Dokumenty / Zgody — regulaminy + zgody RODO.
                                 Route /my/documents (legal.document.version). -->
                            <a href="/my/documents" class="cs-doc-card">
                                <span class="cs-doc-icon">📄</span>
                                <div class="cs-doc-body">
                                    <h5 class="cs-doc-title">Dokumenty / Zgody</h5>
                                    <p class="cs-doc-desc">Regulaminy, polityki i zgody RODO</p>
                                    <span class="cs-doc-cta">Zobacz →</span>
                                </div>
                            </a>
                        </div>
                    </div>

                    <!-- Dodatkowe akcje obozowe (drugorzędne) -->
                    <div class="row g-3 mt-1">
                        <div class="col-md-4">
                            <a href="#" data-bs-toggle="modal" data-bs-target="#csBookCampModal"
                               class="cs-doc-card">
                                <span class="cs-doc-icon">🏕️</span>
                                <div class="cs-doc-body">
                                    <h5 class="cs-doc-title">Zarezerwuj obóz</h5>
                                    <p class="cs-doc-desc">Wolne turnusy i zapis dziecka</p>
                                    <span class="cs-doc-cta">Wybierz obóz →</span>
                                </div>
                            </a>
                        </div>
                        <div class="col-md-4">
                            <a href="/my/stories" class="cs-doc-card">
                                <span class="cs-doc-icon">📖</span>
                                <div class="cs-doc-body">
                                    <h5 class="cs-doc-title">Historie z obozu</h5>
                                    <p class="cs-doc-desc">Codzienne relacje wychowawców</p>
                                    <span class="cs-doc-cta">Czytaj →</span>
                                </div>
                            </a>
                        </div>
                        <div class="col-md-4">
                            <a href="/my/loyalty" class="cs-doc-card">
                                <span class="cs-doc-icon">🏆</span>
                                <div class="cs-doc-body">
                                    <h5 class="cs-doc-title">Program lojalnościowy</h5>
                                    <p class="cs-doc-desc">Twój poziom i zniżki</p>
                                    <span class="cs-doc-cta">Zobacz →</span>
                                </div>
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Modal: вибір табору для бронювання -->
                <div class="modal fade" id="csBookCampModal" tabindex="-1" aria-labelledby="csBookCampLabel" aria-hidden="true">
                    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
                        <div class="modal-content cs-book-modal">
                            <div class="modal-header">
                                <h5 class="modal-title" id="csBookCampLabel">Wybierz obóz do rezerwacji</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Zamknij"/>
                            </div>
                            <div class="modal-body">
                                <t t-if="cs_upcoming_camps">
                                    <div class="row g-3">
                                        <t t-foreach="cs_upcoming_camps" t-as="camp">
                                            <div class="col-md-6">
                                                <a t-attf-href="/event/#{camp.id}" class="cs-camp-option">
                                                    <div class="cs-camp-option-title" t-esc="camp.name"/>
                                                    <div class="cs-camp-option-meta">
                                                        <span class="cs-camp-option-date">
                                                            <t t-if="camp.date_begin" t-esc="camp.date_begin.strftime('%d.%m.%Y')"/>
                                                            <t t-if="camp.date_end"> — <t t-esc="camp.date_end.strftime('%d.%m.%Y')"/></t>
                                                        </span>
                                                        <t t-if="camp.seats_available">
                                                            <span class="cs-camp-option-seats">
                                                                wolne: <t t-esc="camp.seats_available"/>
                                                            </span>
                                                        </t>
                                                    </div>
                                                </a>
                                            </div>
                                        </t>
                                    </div>
                                </t>
                                <t t-else="">
                                    <div class="cs-empty-state">
                                        <div class="cs-empty-icon">🏕️</div>
                                        <h4>Brak otwartych turnusów</h4>
                                        <p class="text-muted">
                                            Zajrzyj później — harmonogram kolejnego sezonu pojawi się tutaj, gdy tylko otworzymy zapisy.
                                        </p>
                                    </div>
                                </t>
                            </div>
                            <div class="modal-footer">
                                <a href="/shop" class="cs-btn-ghost">Zobacz wszystkie obozy w sklepie →</a>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </t>
    </xpath>
</template>

<!-- ============================================================================
     Home portal entry cards — shown in the standard .o_portal_docs grid
     These cards appear for ALL portal users (not only parents with children).
     Counter values are populated by _prepare_home_portal_values via counters.
     ============================================================================ -->

<template id="portal_my_home_stories" inherit_id="portal.portal_my_home" priority="65">
    <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
        <t t-call="portal.portal_docs_entry">
            <t t-set="title">Щоденні історії</t>
            <t t-set="url" t-value="'/my/stories'"/>
            <t t-set="placeholder_count" t-value="'stories_count'"/>
        </t>
    </xpath>
</template>

<template id="portal_my_home_loyalty" inherit_id="portal.portal_my_home" priority="66">
    <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
        <t t-call="portal.portal_docs_entry">
            <t t-set="title">Лояльність</t>
            <t t-set="url" t-value="'/my/loyalty'"/>
            <t t-set="placeholder_count" t-value="'loyalty_count'"/>
        </t>
    </xpath>
</template>

<template id="portal_my_home_documents" inherit_id="portal.portal_my_home" priority="67">
    <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
        <t t-call="portal.portal_docs_entry">
            <t t-set="title">Юридичні документи</t>
            <t t-set="url" t-value="'/my/documents'"/>
            <t t-set="placeholder_count" t-value="'documents_count'"/>
        </t>
    </xpath>
</template>

<!-- Sidebar nav removed: //ul[hasclass('o_portal_submenu')] does not exist in Odoo 17.
     Portal navigation is provided through the hero cards on /my. -->

<!-- ============================================================================
     Breadcrumbs
     ============================================================================ -->

<template id="portal_breadcrumbs_campscout" inherit_id="portal.portal_breadcrumbs" priority="20">
    <!-- Replace the icon-only home link with an explicit «Кабінет батьків»
         text so parents always see the way back, even on stock Odoo pages
         (/my/invoices, /my/orders) where we don't render our own back link. -->
    <xpath expr="//li[hasclass('breadcrumb-item') and hasclass('ms-1')]" position="replace">
        <li class="breadcrumb-item ms-1">
            <a href="/my/home" class="cs-crumb-home">
                <i class="fa fa-home me-1"/>
                <t t-if="user_id.has_group('fayna_camp_portal.group_camp_organizator')">Кабінет організатора</t>
                <t t-elif="user_id.has_group('fayna_camp_portal.group_camp_kierownik')">Кабінет керівника табору</t>
                <t t-elif="user_id.has_group('fayna_camp_portal.group_camp_wychowawca')">Кабінет вихователя</t>
                <t t-elif="user_id.has_group('fayna_camp_portal.group_camp_instructor')">Кабінет інструктора</t>
                <t t-elif="user_id.has_group('fayna_camp_portal.group_camp_finance')">Кабінет бухгалтера</t>
                <t t-else="">Кабінет батьків</t>
            </a>
        </li>
    </xpath>
    <!-- NOTE: o_portal_submenu does not exist in Odoo 17 portal breadcrumbs.
         Page-level breadcrumb items are rendered by each page template via
         the `additional_title` t-set variable passed to portal.portal_layout. -->
</template>

<!-- ============================================================================
     /my/stories — Published camp stories
     ============================================================================ -->

<template id="portal_stories" name="Camp Stories">
    <t t-call="portal.portal_layout">
        <t t-set="additional_title">Щоденні історії з табору</t>

        <div class="cs-page">
            <div class="cs-page-back mb-3">
                <a href="/my" class="cs-back-link">← До кабінету</a>
            </div>

            <div class="cs-page-header mb-4">
                <h2 class="cs-page-title">Щоденні історії з табору</h2>
                <p t-if="not selected_child" class="cs-page-subtitle">Звіти вожатих про життя дітей у таборі</p>
                <p t-if="selected_child" class="cs-page-subtitle">
                    Тільки історії з таборів <strong t-esc="selected_child.display_name"/>.
                    <a href="/my/stories" class="cs-back-link ms-2">показати усіх дітей</a>
                </p>
            </div>

            <!-- Per-child filter chips: live partition by participant. Без
                 hardcoded children — list рендериться з queried records. -->
            <div t-if="children and len(children) > 1" class="cs-stories-filter mb-3">
                <a href="/my/stories"
                   t-attf-class="cs-filter-chip #{('active' if not selected_child else '')}">
                    Усі діти
                </a>
                <t t-foreach="children" t-as="child">
                    <a t-attf-href="/my/stories?participant_id=#{child.id}"
                       t-attf-class="cs-filter-chip #{('active' if selected_child and selected_child.id == child.id else '')}">
                        <t t-esc="child.display_name"/>
                    </a>
                </t>
            </div>

            <div t-if="not stories" class="cs-empty-state">
                <div class="cs-empty-icon">📖</div>
                <h4>Поки що тихо</h4>
                <p class="text-muted">
                    Історії з'являться тут одразу як вожаті опублікують перший щоденний звіт.
                </p>
            </div>

            <div t-foreach="stories" t-as="story" class="cs-story-card mb-3">
                <div class="cs-story-head">
                    <div class="cs-story-meta">
                        <time class="cs-story-date"><t t-esc="story.date.strftime('%d.%m.%Y')"/></time>
                        <span class="cs-story-type" t-attf-data-type="#{story.story_type}">
                            <t t-esc="dict([
                                ('daily_log', 'Щоденник'),
                                ('participant_spotlight', 'Портрет'),
                                ('adventure', 'Пригода'),
                                ('lesson_learned', 'Урок'),
                                ('team_moment', 'Команда'),
                                ('life_skill', 'Навичка'),
                                ('memory', 'Спомин')
                            ]).get(story.story_type, story.story_type)"/>
                        </span>
                    </div>
                    <h3 class="cs-story-title" t-esc="story.title"/>
                </div>
                <div class="cs-story-body">
                    <div t-out="story.content[:300]"/>
                    <t t-if="len(story.content) > 300">
                        <span class="text-muted">...</span>
                    </t>
                </div>
            </div>
        </div>
    </t>
</template>

<!-- ============================================================================
     /my/documents — Legal documents and policies
     ============================================================================ -->

<template id="portal_documents" name="Legal Documents">
    <t t-call="portal.portal_layout">
        <t t-set="additional_title">Юридичні документи</t>

        <div class="cs-page">
            <div class="cs-page-back mb-3">
                <a href="/my" class="cs-back-link">← До кабінету</a>
            </div>

            <div class="cs-page-header mb-4">
                <h2 class="cs-page-title">Юридичні документи</h2>
                <p class="cs-page-subtitle">Умови, політики та згоди, які регулюють ваші відносини з CampScout</p>
            </div>

            <div class="row g-3 cs-doc-grid">
                <div class="col-md-6 col-lg-6">
                    <a href="/privacy-policy" target="_blank" class="cs-doc-card">
                        <span class="cs-doc-icon">🛡️</span>
                        <div class="cs-doc-body">
                            <h5 class="cs-doc-title">Обробка персональних даних</h5>
                            <p class="cs-doc-desc">Умови обробки даних, включаючи дані про дітей (RODO/GDPR)</p>
                            <span class="cs-doc-cta">Читати →</span>
                        </div>
                    </a>
                </div>
                <div class="col-md-6 col-lg-6">
                    <a href="/child-protection" target="_blank" class="cs-doc-card">
                        <span class="cs-doc-icon">🧒</span>
                        <div class="cs-doc-body">
                            <h5 class="cs-doc-title">Безпека дітей</h5>
                            <p class="cs-doc-desc">Політика захисту малолітніх і стандарти обслуговування в таборі</p>
                            <span class="cs-doc-cta">Читати →</span>
                        </div>
                    </a>
                </div>
                <div class="col-md-6 col-lg-6">
                    <a href="/regulamin-panelu-klienta" target="_blank" class="cs-doc-card">
                        <span class="cs-doc-icon">🔐</span>
                        <div class="cs-doc-body">
                            <h5 class="cs-doc-title">Умови користування кабінетом</h5>
                            <p class="cs-doc-desc">Правила користування батьківським особистим кабінетом</p>
                            <span class="cs-doc-cta">Читати →</span>
                        </div>
                    </a>
                </div>
                <div class="col-md-6 col-lg-6">
                    <a href="/terms" target="_blank" class="cs-doc-card">
                        <span class="cs-doc-icon">📄</span>
                        <div class="cs-doc-body">
                            <h5 class="cs-doc-title">Загальні умови</h5>
                            <p class="cs-doc-desc">Основні умови надання послуг табору CampScout</p>
                            <span class="cs-doc-cta">Читати →</span>
                        </div>
                    </a>
                </div>
                <div class="col-md-6 col-lg-6">
                    <a href="/cookie-policy" target="_blank" class="cs-doc-card">
                        <span class="cs-doc-icon">🍪</span>
                        <div class="cs-doc-body">
                            <h5 class="cs-doc-title">Політика cookies</h5>
                            <p class="cs-doc-desc">Які cookies ми використовуємо та навіщо</p>
                            <span class="cs-doc-cta">Читати →</span>
                        </div>
                    </a>
                </div>
            </div>

            <!-- Aggregation page on the main site that lists all current +
                 archived versions of every parent-facing document. -->
            <div class="cs-doc-allversions-link mt-3">
                <a href="/dokumenty-dla-rodzicow" target="_blank" class="cs-btn-ghost">
                    📚 Усі документи для батьків + архівні версії →
                </a>
            </div>

            <div t-if="documents" class="cs-doc-versions mt-5">
                <h5 class="mb-3">Актуальні версії документів</h5>
                <t t-foreach="documents" t-as="doc">
                    <div class="cs-doc-version">
                        <div class="cs-doc-version-head">
                            <h6 class="mb-1">
                                <t t-esc="dict([
                                    ('terms_conditions', 'Умови та положення'),
                                    ('privacy_policy', 'Політика конфіденційності'),
                                    ('rodo_consent', 'Згода RODO'),
                                    ('parental_consent', 'Батьківська згода')
                                ]).get(doc.document_type, doc.document_type)"/>
                            </h6>
                            <small class="text-muted">
                                Версія <t t-esc="doc.version_number"/> від <t t-esc="doc.version_date.strftime('%d.%m.%Y')"/>
                            </small>
                        </div>
                        <div class="cs-doc-version-body">
                            <div t-out="doc.content[:300]"/>
                            <t t-if="len(doc.content) > 300">
                                <span class="text-muted">…</span>
                            </t>
                        </div>
                    </div>
                </t>
            </div>
        </div>
    </t>
</template>

