#. module: fayna_camp_portal
#: model:mail.template,body_html:fayna_camp_portal.email_qualification_reminder_3d
msgid ""
"<div style=\"color:#c00;\">\n"
"                    <p>Dear <t t-out=\"object.parent_partner_id.display_name "
"or object.parent_partner_id.name or 'parent'\"></t>,</p>\n"
"                    <p>\n"
"                        <strong>This is the final reminder.</strong>\n"
"                        The qualification card for <strong><t t-"
"out=\"object.display_name\"></t></strong>\n"
"                        is still unsigned and the deadline is in three "
"days.\n"
"                    </p>\n"
"                    <p>\n"
"                        If it remains unsigned on <strong><t t-"
"out=\"object.auto_refusal_date\"></t></strong>,\n"
"                        the registration is cancelled automatically and a "
"refund is issued\n"
"                        according to the contract.\n"
"                    </p>\n"
"                    <p>\n"
"                        Please sign now in the customer portal to keep the "
"spot.\n"
"                    </p>\n"
"                    <p>Kind regards,<br>CampScout team</p>\n"
"                </div>\n"
"            "
msgstr ""
"<div style=\"color:#c00;\">\n"
"                    <p>Dear <t t-out=\"object.parent_partner_id.display_name "
"or object.parent_partner_id.name or 'parent'\"></t>,</p>\n"
"                    <p>\n"
"                        <strong>This is the final reminder.</strong>\n"
"                        The qualification card for <strong><t t-"
"out=\"object.display_name\"></t></strong>\n"
"                        is still unsigned and the deadline is in three "
"days.\n"
"                    </p>\n"
"                    <p>\n"
"                        If it remains unsigned on <strong><t t-"
"out=\"object.auto_refusal_date\"></t></strong>,\n"
"                        the registration is cancelled automatically and a "
"refund is issued\n"
"                        according to the contract.\n"
"                    </p>\n"
"                    <p>\n"
"                        Please sign now in the customer portal to keep the "
"spot.\n"
"                    </p>\n"
"                    <p>Kind regards,<br>CampScout team</p>\n"
"                </div>\n"
"            "

#. module: fayna_camp_portal
#: model:mail.template,body_html:fayna_camp_portal.email_auto_refusal
msgid ""
"<div>\n"
"                    <p>Dear <t t-out=\"object.parent_partner_id.display_name "
"or object.parent_partner_id.name or 'parent'\"></t>,</p>\n"
"                    <p>\n"
"                        The registration for <strong><t t-"
"out=\"object.display_name\"></t></strong>\n"
"                        has been cancelled automatically because the "
"qualification card\n"
"                        was not signed by the deadline.\n"
"                    </p>\n"
"                    <p>\n"
"                        A refund will be processed according to the contract "
"terms (Umowa §6).\n"
"                        Our finance team will contact you with the exact "
"amount and timing.\n"
"                    </p>\n"
"                    <p>\n"
"                        If this was a mistake, please reply to this email "
"within 48 hours —\n"
"                        we may be able to reinstate the registration if "
"seats are still available.\n"
"                    </p>\n"
"                    <p>Kind regards,<br>CampScout team</p>\n"
"                </div>\n"
"            "
msgstr ""
"<div>\n"
"                    <p>Dear <t t-out=\"object.parent_partner_id.display_name "
"or object.parent_partner_id.name or 'parent'\"></t>,</p>\n"
"                    <p>\n"
"                        The registration for <strong><t t-"
"out=\"object.display_name\"></t></strong>\n"
"                        has been cancelled automatically because the "
"qualification card\n"
"                        was not signed by the deadline.\n"
"                    </p>\n"
"                    <p>\n"
"                        A refund will be processed according to the contract "
"terms (Umowa §6).\n"
"                        Our finance team will contact you with the exact "
"amount and timing.\n"
"                    </p>\n"
"                    <p>\n"
