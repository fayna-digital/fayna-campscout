#. module: fayna_camp_portal
#: model:res.groups,comment:fayna_camp_portal.group_camp_hr
msgid ""
"\n"
"                Camp HR manager — can add and edit staff certifications\n"
"                (KRK, RPS, course certs). PL law: Rozp. MEN 2016 §4.\n"
"            "
msgstr ""

#. module: fayna_camp_portal
#: model:res.groups,comment:fayna_camp_portal.group_camp_leader
msgid ""
"\n"
"                Camp leader — extends Kierownik with sign-off rights:\n"
"                can invoke sign_qualification() and complete_section_iii()\n"
"                on camp.participant. Required by PL law (Rozp. MEN 2016 §5).\n"
"            "
msgstr ""

#. module: fayna_camp_portal
#: model:res.groups,comment:fayna_camp_portal.group_fayna_camp_manager
msgid ""
"\n"
"                Camp manager — full access to camp.program (Program Wypoczynku,\n"
"                Załącznik 9) including approve/submit workflow. Can override\n"
"                immutability where PL law permits (incident post-closure edits).\n"
"            "
msgstr ""

#. module: fayna_camp_portal
#: model:res.groups,comment:fayna_camp_portal.group_camp_admin
msgid ""
"\n"
"                Camp operations admin — full access to camp.report including\n"
"                revert-to-draft on submitted reports. Implied by camp_manager.\n"
"            "
msgstr ""

#. module: fayna_camp_portal
#: model:res.groups,comment:fayna_camp_portal.group_emergency_manager
msgid ""
"\n"
"                Emergency manager — full access to incident lifecycle including\n"
"                close, reopen, and override state. Immutable ledger enforcement\n"
"                applies post-close (BP-006, Ustawa Kamilka 2024).\n"
"            "
msgstr ""

#. module: fayna_camp_portal
#: model:res.groups,comment:fayna_camp_portal.group_emergency_responder
msgid ""
"\n"
"                First-responder — can create/update camp.incident reports and\n"
"                camp.incident.action entries. Cannot close or reopen incidents.\n"
"                Required by BP-006 SLA (10s first action trigger).\n"
"            "
msgstr ""

#. module: fayna_camp_portal
#: model:res.groups,comment:fayna_camp_portal.group_camp_instructor
msgid ""
"\n"
"                Instructor — specialist for one or more activities (swimming,\n"
"                climbing, archery). Sees own activities via record rule\n"
"                camp.activity.responsible_id == self. Sees only attendees with\n"
"                relevant medical info (e.g., asthma for running).\n"
"            "
msgstr ""

#. module: fayna_camp_portal
#: model:res.groups,comment:fayna_camp_portal.group_camp_kierownik
msgid ""
"\n"
"                Kierownik (camp shift director) — can create/edit camp.journal,\n"
"                camp.daily.report, camp.staff entries. Cannot approve Załącznik 9\n"
"                (that requires group_fayna_camp_manager).\n"
"            "
msgstr ""

#. module: fayna_camp_portal
#: model:res.groups,comment:fayna_camp_portal.group_medical_officer
msgid ""
"\n"
"                Medical officer — read/write access to RODO Art.9 special-category\n"
"                health fields: allergies, medications, chronic_conditions, doctor_notes\n"
"                on camp.participant. Requires signed DPA with organizer.\n"
"            "
msgstr ""

#. module: fayna_camp_portal
#: model:res.groups,comment:fayna_camp_portal.group_nutrition_officer
msgid ""
"\n"
"                Nutrition officer — read/write access to dietary and allergen data\n"
"                on camp.participant.diet (RODO Art.9 special-category data).\n"
"                EU Regulation 1169/2011 (14 major allergens).\n"
"            "
msgstr ""

#. module: fayna_camp_portal
#: model:res.groups,comment:fayna_camp_portal.group_camp_organizator
msgid ""
"\n"
"                Organizator Wypoczynku per PL law (Rozp. MEN 30.03.2016 §2.1).\n"
"                Legal person/entity (foundation, scout org, company) registered\n"
"                with Kuratorium Oświaty. Bypasses all record rules (via\n"
"                base.group_system), lands on /admin/dashboard, can\n"
"                /admin/as-{role} impersonate any role. Each impersonation\n"
"                logged in camp.admin.access.log (RODO art.30, 7-year retention).\n"
"            "
msgstr ""

#. module: fayna_camp_portal
#: model:res.groups,comment:fayna_camp_portal.group_camp_sales
msgid ""
"\n"
"                Sales/marketing manager — catalog, prices, sale.order, support\n"
"                requests, marketing reports, public stories. NO access to medical\n"
"                data, kuratorium, dziennik, daily reports, incidents.\n"
"            "
msgstr ""

#. module: fayna_camp_portal
#: model:res.groups,comment:fayna_camp_portal.group_camp_wychowawca
msgid ""
"\n"
"                Wychowawca — runs activities for own group of children. Sees own\n"
"                group only via record rule camp.staff.event_id == self. Sees\n"
"                allergies + emergency_contact (children) but NOT medications/\n"
"                doctor_notes. Załącznik 5 MEN dziennik signing rights.\n"
"            "
msgstr ""

