<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- ════════════════════════════════════════════════════════════════
             fayna.vozhatyi.training — TREE
        ════════════════════════════════════════════════════════════════ -->
        <record id="fayna_vozhatyi_training_tree" model="ir.ui.view">
            <field name="name">fayna.vozhatyi.training.tree</field>
            <field name="model">fayna.vozhatyi.training</field>
            <field name="arch" type="xml">
                <tree decoration-success="state == 'certified'"
                      decoration-info="state == 'in_progress'"
                      decoration-muted="state == 'draft'">
                    <field name="name"/>
                    <field name="participant_id"/>
                    <field name="training_type"/>
                    <field name="start_date"/>
                    <field name="end_date"/>
                    <field name="total_hours"/>
                    <field name="required_hours"/>
                    <field name="completion_pct" widget="progressbar"/>
                    <field name="state" widget="badge"
                           decoration-success="state == 'certified'"
                           decoration-info="state == 'in_progress'"
                           decoration-warning="state == 'completed'"
                           decoration-muted="state == 'draft'"/>
                </tree>
            </field>
        </record>

        <!-- ════════════════════════════════════════════════════════════════
             fayna.vozhatyi.training — FORM
        ════════════════════════════════════════════════════════════════ -->
        <record id="fayna_vozhatyi_training_form" model="ir.ui.view">
            <field name="name">fayna.vozhatyi.training.form</field>
            <field name="model">fayna.vozhatyi.training</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_start" string="Start" type="object"
                                class="btn-primary"
                                invisible="state != 'draft'"/>
                        <button name="action_complete" string="Complete &amp; Issue Certificate"
                                type="object" class="btn-success"
                                invisible="state not in ('draft', 'in_progress')"/>
                        <button name="action_reset_draft" string="Reset to Draft"
                                type="object"
                                invisible="state in ('draft', 'certified')"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="draft,in_progress,completed,certified"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name" placeholder="Training Name"/></h1>
                        </div>
                        <group>
                            <group string="Participant">
                                <field name="participant_id"/>
                                <field name="training_type"/>
                                <field name="instructor_id"/>
                            </group>
                            <group string="Schedule">
                                <field name="start_date"/>
                                <field name="end_date"/>
                                <field name="location"/>
                            </group>
                        </group>
                        <group string="Progress">
                            <group>
                                <field name="total_hours"/>
                                <field name="required_hours"/>
                                <field name="completion_pct" widget="progressbar"/>
                            </group>
                            <group>
                                <field name="certificate_date"
                                       invisible="state not in ('completed', 'certified')"/>
                                <field name="certificate_number"
                                       invisible="state not in ('completed', 'certified')"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="Modules">
                                <field name="module_ids">
                                    <tree editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="module_type"/>
                                        <field name="name"/>
                                        <field name="hours"/>
                                        <field name="completed"/>
                                        <field name="completion_date"
                                               invisible="not completed"/>
                                        <field name="notes"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Certificates"
                                  invisible="state not in ('completed', 'certified')">
                                <field name="certificate_ids" readonly="1">
                                    <tree>
                                        <field name="certificate_number"/>
                                        <field name="cert_type"/>
                                        <field name="issue_date"/>
                                        <field name="valid_until"/>
                                        <field name="is_expired"/>
                                        <field name="state" widget="badge"
                                               decoration-success="state == 'active'"
                                               decoration-danger="state == 'expired'"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- ════════════════════════════════════════════════════════════════
             fayna.vozhatyi.training — SEARCH
        ════════════════════════════════════════════════════════════════ -->
        <record id="fayna_vozhatyi_training_search" model="ir.ui.view">
            <field name="name">fayna.vozhatyi.training.search</field>
            <field name="model">fayna.vozhatyi.training</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="participant_id"/>
                    <field name="instructor_id"/>
                    <filter string="Draft" name="filter_draft"
                            domain="[('state','=','draft')]"/>
                    <filter string="In Progress" name="filter_in_progress"
                            domain="[('state','=','in_progress')]"/>
                    <filter string="Certified" name="filter_certified"
                            domain="[('state','=','certified')]"/>
                    <separator/>
                    <filter string="Wychowawca 36h" name="filter_wychowawca"
                            domain="[('training_type','=','wychowawca_36h')]"/>
                    <filter string="Kierownik 10h" name="filter_kierownik"
                            domain="[('training_type','=','kierownik_10h')]"/>
                    <group expand="0" string="Group By">
                        <filter string="Participant" name="group_participant"
                                context="{'group_by': 'participant_id'}"/>
                        <filter string="Type" name="group_type"
                                context="{'group_by': 'training_type'}"/>
                        <filter string="Status" name="group_state"
                                context="{'group_by': 'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="fayna_vozhatyi_training_action" model="ir.actions.act_window">
            <field name="name">Training Programs (MEN 36h/10h)</field>
            <field name="res_model">fayna.vozhatyi.training</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="fayna_vozhatyi_training_search"/>
            <field name="context">{}</field>
        </record>

        <!-- ════════════════════════════════════════════════════════════════
             fayna.vozhatyi.certificate — TREE
        ════════════════════════════════════════════════════════════════ -->
        <record id="fayna_vozhatyi_certificate_tree" model="ir.ui.view">
            <field name="name">fayna.vozhatyi.certificate.tree</field>
            <field name="model">fayna.vozhatyi.certificate</field>
            <field name="arch" type="xml">
                <tree decoration-danger="state == 'expired'"
                      decoration-success="state == 'active'">
                    <field name="certificate_number"/>
                    <field name="partner_id"/>
                    <field name="cert_type"/>
                    <field name="training_id"/>
                    <field name="issue_date"/>
                    <field name="valid_until"/>
                    <field name="is_expired"/>
                    <field name="state" widget="badge"
                           decoration-success="state == 'active'"
                           decoration-danger="state == 'expired'"/>
                </tree>
            </field>
        </record>

        <!-- ════════════════════════════════════════════════════════════════
             fayna.vozhatyi.certificate — FORM
        ════════════════════════════════════════════════════════════════ -->
        <record id="fayna_vozhatyi_certificate_form" model="ir.ui.view">
            <field name="name">fayna.vozhatyi.certificate.form</field>
            <field name="model">fayna.vozhatyi.certificate</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_mark_expired" string="Revoke / Expire"
                                type="object" class="btn-danger"
                                invisible="state == 'expired'"/>
                        <button name="action_print_certificate" string="Print Certificate"
                                type="object" class="btn-secondary"
                                invisible="state == 'expired'"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="active,expired"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="certificate_number" readonly="1"/></h1>
                        </div>
                        <group>
                            <group string="Holder">
                                <field name="partner_id"/>
                                <field name="cert_type"/>
                                <field name="training_id"/>
                            </group>
                            <group string="Validity">
                                <field name="issue_date"/>
                                <field name="valid_until"/>
                                <field name="is_expired"/>
                            </group>
                        </group>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- ════════════════════════════════════════════════════════════════
             fayna.vozhatyi.certificate — SEARCH
        ════════════════════════════════════════════════════════════════ -->
        <record id="fayna_vozhatyi_certificate_search" model="ir.ui.view">
            <field name="name">fayna.vozhatyi.certificate.search</field>
            <field name="model">fayna.vozhatyi.certificate</field>
            <field name="arch" type="xml">
                <search>
                    <field name="certificate_number"/>
                    <field name="partner_id"/>
                    <filter string="Active" name="filter_active"
                            domain="[('state','=','active')]"/>
                    <filter string="Expired" name="filter_expired"
                            domain="[('state','=','expired')]"/>
                    <group expand="0" string="Group By">
                        <filter string="Holder" name="group_partner"
                                context="{'group_by': 'partner_id'}"/>
                        <filter string="Status" name="group_state"
                                context="{'group_by': 'state'}"/>
                        <filter string="Issue Year" name="group_year"
                                context="{'group_by': 'issue_date:year'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="fayna_vozhatyi_certificate_action" model="ir.actions.act_window">
            <field name="name">Vozhatyi Certificates</field>
            <field name="res_model">fayna.vozhatyi.certificate</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="fayna_vozhatyi_certificate_search"/>
        </record>

        <!-- ════════════════════════════════════════════════════════════════
             vozhatyi.training.record — TREE
        ════════════════════════════════════════════════════════════════ -->
        <record id="vozhatyi_training_record_tree" model="ir.ui.view">
            <field name="name">vozhatyi.training.record.tree</field>
            <field name="model">vozhatyi.training.record</field>
            <field name="arch" type="xml">
                <tree decoration-success="state == 'completed'"
                      decoration-muted="state == 'expired'"
                      decoration-info="state == 'enrolled'">
                    <field name="partner_id"/>
                    <field name="training_type"/>
                    <field name="completion_date"/>
                    <field name="valid_until"/>
                    <field name="state" widget="badge"
                           decoration-success="state == 'completed'"
                           decoration-muted="state == 'expired'"
                           decoration-info="state == 'enrolled'"/>
                </tree>
            </field>
        </record>

        <!-- ════════════════════════════════════════════════════════════════
             vozhatyi.training.record — FORM
        ════════════════════════════════════════════════════════════════ -->
        <record id="vozhatyi_training_record_form" model="ir.ui.view">
            <field name="name">vozhatyi.training.record.form</field>
            <field name="model">vozhatyi.training.record</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_complete"
                                string="Mark Completed"
                                type="object"
                                class="btn-success"
                                invisible="state != 'enrolled'"/>
                        <button name="action_expire"
                                string="Mark Expired"
                                type="object"
                                class="btn-warning"
                                invisible="state == 'expired'"/>
                        <button name="action_reset_enrolled"
                                string="Re-enrol"
                                type="object"
                                invisible="state == 'enrolled'"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="enrolled,completed,expired"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="display_name" readonly="1"/></h1>
                        </div>
                        <group>
                            <group string="Trainee">
                                <field name="partner_id"/>
                                <field name="training_type"/>
                            </group>
                            <group string="Completion">
                                <field name="completion_date"/>
                                <field name="certificate_number"/>
                                <field name="valid_until"/>
                            </group>
                        </group>
                        <group string="Notes">
                            <field name="notes" nolabel="1"/>
                        </group>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- ════════════════════════════════════════════════════════════════
             vozhatyi.training.record — SEARCH
        ════════════════════════════════════════════════════════════════ -->
        <record id="vozhatyi_training_record_search" model="ir.ui.view">
            <field name="name">vozhatyi.training.record.search</field>
            <field name="model">vozhatyi.training.record</field>
            <field name="arch" type="xml">
                <search>
                    <field name="partner_id"/>
                    <field name="certificate_number"/>
                    <filter string="Enrolled" name="filter_enrolled"
                            domain="[('state','=','enrolled')]"/>
                    <filter string="Completed" name="filter_completed"
                            domain="[('state','=','completed')]"/>
                    <filter string="Expired" name="filter_expired"
                            domain="[('state','=','expired')]"/>
                    <separator/>
                    <filter string="Wychowawca 36h" name="filter_wychowawca"
                            domain="[('training_type','=','wychowawca_36h')]"/>
                    <filter string="Kierownik 10h" name="filter_kierownik"
                            domain="[('training_type','=','kierownik_10h')]"/>
                    <group expand="0" string="Group By">
                        <filter string="Trainee" name="group_partner"
                                context="{'group_by': 'partner_id'}"/>
                        <filter string="Training Type" name="group_type"
                                context="{'group_by': 'training_type'}"/>
                        <filter string="Status" name="group_state"
                                context="{'group_by': 'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="vozhatyi_training_record_action" model="ir.actions.act_window">
            <field name="name">Vozhatyi Training Records</field>
            <field name="res_model">vozhatyi.training.record</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="vozhatyi_training_record_search"/>
        </record>

        <!-- ════════════════════════════════════════════════════════════════
             QWeb PDF Certificate Report
        ════════════════════════════════════════════════════════════════ -->
        <record id="fayna_vozhatyi_certificate_report_action" model="ir.actions.report">
            <field name="name">Training Certificate</field>
            <field name="model">fayna.vozhatyi.certificate</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">fayna_camp_portal.fayna_vozhatyi_certificate_report_template</field>
            <field name="report_file">fayna_camp_portal.fayna_vozhatyi_certificate_report_template</field>
            <field name="binding_model_id" ref="model_fayna_vozhatyi_certificate"/>
            <field name="binding_type">report</field>
            <field name="paperformat_id" ref="base.paperformat_euro"/>
        </record>

        <template id="fayna_vozhatyi_certificate_report_template">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="web.external_layout">
                        <div class="page">
                            <!-- Header / Title -->
                            <div style="text-align:center; margin-bottom:40px;">
                                <h1 style="font-size:28pt; text-transform:uppercase; letter-spacing:3px;">
                                    Certificate of Completion
                                </h1>
                                <p style="font-size:13pt; color:#555;">
                                    Zaświadczenie ukończenia kursu / Свідоцтво про закінчення курсу
                                </p>
                                <hr style="border:2px solid #20ac41; margin:16px auto; width:60%;"/>
                            </div>

                            <!-- Body -->
                            <div style="text-align:center; font-size:13pt; line-height:2;">
                                <p>This certifies that</p>
                                <h2 style="font-size:22pt; color:#20ac41;">
                                    <t t-esc="o.partner_id.name"/>
                                </h2>
                                <p>has successfully completed the</p>
                                <h3 style="font-size:16pt;">
                                    <t t-esc="o.training_id.training_type == 'wychowawca_36h' and 'Wychowawca Course (36h)' or 'Kierownik Course (10h)'"/>
                                </h3>
                                <p>as required by Rozporządzenie MEN 2016 (Dz.U. 2016 poz. 2148)</p>
                            </div>

                            <!-- Certificate Details -->
                            <div style="margin-top:40px; border:1px solid #ddd; padding:16px; border-radius:6px;">
                                <table style="width:100%; font-size:11pt;">
                                    <tr>
                                        <td style="width:40%; color:#777;">Certificate Number:</td>
                                        <td><strong><t t-esc="o.certificate_number"/></strong></td>
                                    </tr>
                                    <tr>
                                        <td style="color:#777;">Issue Date:</td>
                                        <td><t t-esc="o.issue_date"/></td>
                                    </tr>
                                    <tr>
                                        <td style="color:#777;">Valid Until:</td>
                                        <td><t t-esc="o.valid_until"/></td>
                                    </tr>
                                    <tr>
                                        <td style="color:#777;">Instructor:</td>
                                        <td><t t-esc="o.training_id.instructor_id.name or '—'"/></td>
                                    </tr>
                                    <tr>
                                        <td style="color:#777;">Training Location:</td>
                                        <td><t t-esc="o.training_id.location or '—'"/></td>
                                    </tr>
                                    <tr>
                                        <td style="color:#777;">Total Hours Completed:</td>
                                        <td><t t-esc="o.training_id.total_hours"/> h</td>
                                    </tr>
                                </table>
                            </div>

                            <!-- Modules completed -->
                            <div style="margin-top:24px;">
                                <h4>Modules Completed / Ukończone moduły:</h4>
                                <table style="width:100%; font-size:10pt; border-collapse:collapse;">
                                    <thead>
                                        <tr style="background:#20ac41; color:white;">
                                            <th style="padding:6px; text-align:left;">Module</th>
                                            <th style="padding:6px; text-align:right;">Hours</th>
                                            <th style="padding:6px; text-align:center;">Date</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="o.training_id.module_ids.filtered(lambda m: m.completed)" t-as="mod">
                                            <tr>
                                                <td style="padding:5px; border-bottom:1px solid #eee;">
                                                    <t t-esc="mod.name"/>
                                                </td>
                                                <td style="padding:5px; border-bottom:1px solid #eee; text-align:right;">
                                                    <t t-esc="mod.hours"/>
                                                </td>
                                                <td style="padding:5px; border-bottom:1px solid #eee; text-align:center;">
                                                    <t t-esc="mod.completion_date"/>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>

                            <!-- Signature area -->
                            <div style="margin-top:60px; display:flex; justify-content:space-between;">
                                <div style="text-align:center; width:40%;">
                                    <div style="border-top:1px solid #333; padding-top:8px;">Instructor Signature</div>
                                </div>
                                <div style="text-align:center; width:40%;">
                                    <div style="border-top:1px solid #333; padding-top:8px;">Organizer Stamp / Seal</div>
                                </div>
                            </div>
                        </div>
                    </t>
                </t>
            </t>
        </template>

        <!-- ════════════════════════════════════════════════════════════════
             Menu items — under existing "Навчання" (menu_training)
        ════════════════════════════════════════════════════════════════ -->
        <menuitem id="menu_vozhatyi_training_programs"
                  name="MEN Programs (36h/10h)"
                  parent="menu_training"
                  action="fayna_vozhatyi_training_action"
                  sequence="30"/>

        <menuitem id="menu_vozhatyi_certificates"
                  name="Vozhatyi Certificates"
                  parent="menu_training"
                  action="fayna_vozhatyi_certificate_action"
                  sequence="40"/>

        <menuitem id="menu_vozhatyi_training_records"
                  name="Vozhatyi Records (flat)"
                  parent="menu_training"
                  action="vozhatyi_training_record_action"
                  sequence="50"/>
    </data>
</odoo>
