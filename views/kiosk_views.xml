<?xml version="1.0" encoding="utf-8"?>
<!--
    Kiosk shell per role (TZ §4 — КІОСК vs повний Odoo).
    Roles: group_camp_kierownik / group_camp_wychowawca / group_camp_instructor.

    ir.actions.client → tag "camp_kiosk" → OWL root CampKiosk
    (static/src/js/kiosk_app.js).

    Home action is set per-group via res.users._get_login_action override
    in models/res_users_inherit.py (same pattern as group_camp_organizator
    already in place).

    Toggle "↔ Odoo" systray (kiosk_odoo_toggle_systray.js) visible only
    to base.group_system | group_camp_organizator.
-->
<odoo>
    <data>

        <!-- ═══════════════════════════════════════════════════════════════
             Client action — OWL root CampKiosk.
             target=fullscreen hides the navbar (same as manufacturing kiosk).
             tag must match registry.category("actions").add(tag, Component)
             in kiosk_app.js.
        ═══════════════════════════════════════════════════════════════ -->

        <record id="camp_kiosk_action" model="ir.actions.client">
            <field name="name">Kiosk CampScout</field>
            <field name="tag">camp_kiosk</field>
            <field name="target">fullscreen</field>
        </record>

        <!-- ═══════════════════════════════════════════════════════════════
             "Moje obozy" — shifts where the current user is the kierownik
             (event.user_id) OR a member of the kadra (staff_ids.user_id).
             uid is resolved by Odoo at act_window context evaluation.
             Resolved via env.ref() by the kiosk tile (_KIEROWNIK_TILES).
        ═══════════════════════════════════════════════════════════════ -->

        <record id="action_camp_moje_obozy" model="ir.actions.act_window">
            <field name="name">Moje obozy</field>
            <field name="res_model">event.event</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="domain">['|', ('user_id', '=', uid), ('staff_ids.user_id', '=', uid)]</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Nie masz jeszcze przypisanych obozów
                </p>
                <p>
                    Tu pojawią się zmiany, których jesteś kierownikiem
                    lub w których wchodzisz w skład kadry.
                </p>
            </field>
        </record>

        <!-- ═══════════════════════════════════════════════════════════════
             Kiosk menu entry — visible to kiosk roles only.
             Organizator has group_system → already hidden from this tile
             via menu_scoping; kierownik/wychowawca/instructor see it.
        ═══════════════════════════════════════════════════════════════ -->

        <menuitem id="menu_camp_kiosk_root"
            name="Kiosk"
            action="camp_kiosk_action"
            sequence="1"
            groups="fayna_camp_portal.group_camp_kierownik,fayna_camp_portal.group_camp_wychowawca,fayna_camp_portal.group_camp_instructor"/>

    </data>
</odoo>
