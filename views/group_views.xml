<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ================================================================ -->
        <!-- camp.group — grupa wychowawcza (§2 art. 92c)                     -->
        <!-- NOTE: menu item is added in views/menus.xml by the integrator.   -->
        <!-- ================================================================ -->

        <record id="view_camp_group_tree" model="ir.ui.view">
            <field name="name">camp.group.tree</field>
            <field name="model">camp.group</field>
            <field name="arch" type="xml">
                <tree decoration-danger="participant_count &gt; capacity_limit"
                      decoration-warning="participant_count == capacity_limit">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="event_id"/>
                    <field name="wychowawca_ids" widget="many2many_tags"/>
                    <field name="participant_count" string="Children"/>
                    <field name="capacity_limit" string="Limit (art. 92c)"/>
                    <field name="has_under_10"/>
                    <field name="disabled_count"/>
                </tree>
            </field>
        </record>

        <record id="view_camp_group_form" model="ir.ui.view">
            <field name="name">camp.group.form</field>
            <field name="model">camp.group</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_auto_split_event"
                                type="object"
                                string="Auto-split unassigned children"
                                class="btn-primary"
                                invisible="not event_id"
                                help="Distribute the remaining unassigned children of this camp shift into age-based groups (under-10 separately, limits 15/20 per art. 92c)."/>
                    </header>
                    <sheet>
                        <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                        <div class="oe_title">
                            <h1><field name="name" placeholder="e.g. Grupa A"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="event_id"/>
                                <field name="wychowawca_ids" widget="many2many_tags"/>
                                <field name="sequence"/>
                                <field name="active" invisible="1"/>
                            </group>
                            <group>
                                <label for="participant_count" string="Occupancy"/>
                                <div class="o_row">
                                    <field name="participant_count" class="oe_inline"/>
                                    <span> / </span>
                                    <field name="capacity_limit" class="oe_inline"/>
                                </div>
                                <field name="has_under_10"/>
                                <field name="disabled_count"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Participants" name="participants">
                                <field name="participant_ids"
                                       context="{'default_group_id': id}">
                                    <tree>
                                        <field name="display_name"/>
                                        <field name="birth_date"/>
                                        <field name="age"/>
                                        <field name="gender" optional="hide"/>
                                        <field name="special_needs" optional="hide"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Notes" name="notes">
                                <field name="notes" nolabel="1"/>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="view_camp_group_kanban" model="ir.ui.view">
            <field name="name">camp.group.kanban</field>
            <field name="model">camp.group</field>
            <field name="arch" type="xml">
                <kanban default_group_by="event_id" class="o_kanban_small_column">
                    <field name="id"/>
                    <field name="name"/>
                    <field name="event_id"/>
                    <field name="participant_count"/>
                    <field name="capacity_limit"/>
                    <field name="has_under_10"/>
                    <field name="wychowawca_ids"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_card oe_kanban_global_click">
                                <div class="oe_kanban_content">
                                    <div class="o_kanban_record_top">
                                        <div class="o_kanban_record_headings">
                                            <strong class="o_kanban_record_title">
                                                <field name="name"/>
                                            </strong>
                                        </div>
                                    </div>
                                    <div class="o_kanban_record_body">
                                        <div class="text-muted small">
                                            <field name="event_id"/>
                                        </div>
                                    </div>
                                    <div class="o_kanban_record_bottom">
                                        <div class="oe_kanban_bottom_left">
                                            <field name="wychowawca_ids" widget="many2many_avatar_user"/>
                                        </div>
                                        <div class="oe_kanban_bottom_right">
                                            <span t-attf-class="badge #{record.participant_count.raw_value &gt;= record.capacity_limit.raw_value ? 'bg-danger' : 'bg-success'}">
                                                <field name="participant_count"/>/<field name="capacity_limit"/>
                                            </span>
                                            <t t-if="record.has_under_10.raw_value">
                                                <span class="badge bg-warning" title="Includes children under 10 — limit 15 (art. 92c)">&lt;10</span>
                                            </t>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="view_camp_group_search" model="ir.ui.view">
            <field name="name">camp.group.search</field>
            <field name="model">camp.group</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="event_id"/>
                    <field name="wychowawca_ids"/>
                    <!-- NOTE: has_under_10 / capacity_limit are non-stored
                         computes — intentionally no search filter on them. -->
                    <filter name="archived" string="Archived"
                            domain="[('active', '=', False)]"/>
                    <group expand="0" string="Group By">
                        <filter name="by_event" string="Camp shift"
                                context="{'group_by': 'event_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_camp_group" model="ir.actions.act_window">
            <field name="name">Grupy wychowawcze</field>
            <field name="res_model">camp.group</field>
            <field name="view_mode">tree,kanban,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a wychowawca group
                </p>
                <p>
                    Art. 92c: max 20 children per group, max 15 when the group
                    includes a child under 10. Use the auto-split button to
                    distribute unassigned children of a shift by age.
                </p>
            </field>
        </record>

    </data>
</odoo>
