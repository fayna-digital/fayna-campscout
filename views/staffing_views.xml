<?xml version="1.0" encoding="utf-8"?>
<!-- Fayna CampScout — автоштат §6: вакансії + event Staffing + майстер «Новий табір».
     menuitem НЕ додається тут (інтеграція в views/menus.xml — окремий крок). -->
<odoo>
    <data>

        <!-- ============================================================ -->
        <!-- camp.staff.vacancy — tree                                    -->
        <!-- ============================================================ -->
        <record id="view_camp_staff_vacancy_tree" model="ir.ui.view">
            <field name="name">camp.staff.vacancy.tree</field>
            <field name="model">camp.staff.vacancy</field>
            <field name="arch" type="xml">
                <tree decoration-success="state == 'hired'"
                      decoration-muted="state == 'closed'"
                      decoration-info="state == 'candidate'">
                    <field name="name"/>
                    <field name="event_id"/>
                    <field name="role"/>
                    <field name="candidate_name"/>
                    <field name="salary_amount" widget="monetary" optional="show"/>
                    <field name="currency_id" column_invisible="1"/>
                    <field name="staff_id" optional="show"/>
                    <field name="state" widget="badge"
                           decoration-success="state == 'hired'"
                           decoration-info="state == 'candidate'"
                           decoration-warning="state == 'open'"/>
                </tree>
            </field>
        </record>

        <!-- ============================================================ -->
        <!-- camp.staff.vacancy — form                                    -->
        <!-- ============================================================ -->
        <record id="view_camp_staff_vacancy_form" model="ir.ui.view">
            <field name="name">camp.staff.vacancy.form</field>
            <field name="model">camp.staff.vacancy</field>
            <field name="arch" type="xml">
                <form string="Wakat kadry">
                    <header>
                        <button name="action_set_candidate" type="object"
                                string="Mam kandydata"
                                invisible="state != 'open'"/>
                        <button name="action_hire" type="object"
                                string="Zatrudnij (draft staff)" class="oe_highlight"
                                invisible="state not in ('open', 'candidate')"
                                help="Створює camp.staff у draft — підтвердження лише після верифікації KRK/RSPTS (§13)."/>
                        <button name="action_close" type="object" string="Zamknij"
                                invisible="state == 'closed'"
                                confirm="Закрити вакансію вручну? Двигун автоштату НЕ закриває вакансії сам (R13)."/>
                        <button name="action_reopen" type="object" string="Otwórz ponownie"
                                invisible="state != 'closed'"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="open,candidate,hired"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name" placeholder="Wakat wychowawca #1"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="event_id"/>
                                <field name="role"/>
                                <field name="candidate_name"/>
                                <field name="staff_id" readonly="1"/>
                            </group>
                            <group>
                                <field name="salary_amount" widget="monetary"/>
                                <field name="currency_id" invisible="1"/>
                                <field name="created_reason" readonly="1"/>
                            </group>
                        </group>
                        <group string="Notatki">
                            <field name="notes" nolabel="1" colspan="2"
                                   placeholder="Джерело кандидата, нотатки співбесіди, доступність…"/>
                        </group>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- ============================================================ -->
        <!-- camp.staff.vacancy — kanban по state                         -->
        <!-- ============================================================ -->
        <record id="view_camp_staff_vacancy_kanban" model="ir.ui.view">
            <field name="name">camp.staff.vacancy.kanban</field>
            <field name="model">camp.staff.vacancy</field>
            <field name="arch" type="xml">
                <kanban default_group_by="state" quick_create="false">
                    <field name="state"/>
                    <field name="role"/>
                    <field name="currency_id"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_global_click">
                                <strong><field name="name"/></strong>
                                <div><field name="event_id"/></div>
                                <div>
                                    <span class="badge text-bg-light"><field name="role"/></span>
                                </div>
                                <div t-if="record.candidate_name.raw_value">
                                    <i class="fa fa-user" title="Kandydat"/> <field name="candidate_name"/>
                                </div>
                                <div class="text-muted">
                                    <field name="salary_amount" widget="monetary"/>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- ============================================================ -->
        <!-- camp.staff.vacancy — search                                  -->
        <!-- ============================================================ -->
        <record id="view_camp_staff_vacancy_search" model="ir.ui.view">
            <field name="name">camp.staff.vacancy.search</field>
            <field name="model">camp.staff.vacancy</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="event_id"/>
                    <field name="candidate_name"/>
                    <filter name="filter_open" string="Open" domain="[('state', '=', 'open')]"/>
                    <filter name="filter_pipeline" string="Pipeline (open/candidate/hired)"
                            domain="[('state', 'in', ('open', 'candidate', 'hired'))]"/>
                    <filter name="filter_wychowawca" string="Wychowawcy"
                            domain="[('role', '=', 'wychowawca')]"/>
                    <group expand="0" string="Group By">
                        <filter name="group_event" string="Camp shift" context="{'group_by': 'event_id'}"/>
                        <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                        <filter name="group_role" string="Role" context="{'group_by': 'role'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_camp_staff_vacancy" model="ir.actions.act_window">
            <field name="name">Wakaty kadry</field>
            <field name="res_model">camp.staff.vacancy</field>
            <field name="view_mode">tree,kanban,form</field>
            <field name="search_view_id" ref="view_camp_staff_vacancy_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Brak wakatów</p>
                <p>Двигун автоштату (§2 art. 92c) відкриває вакансії автоматично,
                   коли реєстрації перетинають поріг 15/20 дітей на wychowawcę.</p>
            </field>
        </record>

        <!-- ============================================================ -->
        <!-- event.event — smart button + вкладка Staffing                -->
        <!-- ============================================================ -->
        <record id="view_event_form_staffing" model="ir.ui.view">
            <field name="name">event.event.form.staffing</field>
            <field name="model">event.event</field>
            <field name="inherit_id" ref="event.view_event_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_open_staff_vacancies"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-users"
                            groups="fayna_camp_portal.group_camp_kierownik,fayna_camp_portal.group_camp_organizator,fayna_camp_portal.group_camp_admin,fayna_camp_portal.group_camp_hr"
                            help="Wychowawcy: zatrudnieni / wymagani (art. 92c) + wakaty.">
                        <div class="o_stat_info">
                            <span class="o_stat_value">
                                <field name="current_wychowawcy"/>/<field name="required_wychowawcy"/>
                            </span>
                            <span class="o_stat_text">Wychowawcy</span>
                        </div>
                    </button>
                </xpath>
                <xpath expr="//notebook" position="inside">
                    <page string="Staffing" name="camp_staffing"
                          groups="fayna_camp_portal.group_camp_kierownik,fayna_camp_portal.group_camp_organizator,fayna_camp_portal.group_camp_admin,fayna_camp_portal.group_camp_hr">
                        <group>
                            <group string="Potrzeba (art. 92c)">
                                <field name="required_wychowawcy"/>
                                <field name="current_wychowawcy"/>
                                <field name="staffing_gap"/>
                            </group>
                            <group string="Stan">
                                <field name="staff_vacancy_count"/>
                                <field name="overstaffed" widget="boolean_toggle" readonly="1"/>
                            </group>
                        </group>
                        <div class="alert alert-warning" role="alert" invisible="not overstaffed">
                            Overstaffing: потреба впала нижче найнятої кадри.
                            Вакансії/кадра НЕ закриваються автоматично (R13) — рішення за організатором.
                        </div>
                        <field name="staff_vacancy_ids">
                            <tree editable="bottom">
                                <field name="name"/>
                                <field name="role"/>
                                <field name="candidate_name"/>
                                <field name="salary_amount" widget="monetary"/>
                                <field name="currency_id" column_invisible="1"/>
                                <field name="staff_id" readonly="1"/>
                                <field name="state" widget="badge"/>
                            </tree>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>

        <!-- ============================================================ -->
        <!-- camp.create.wizard — майстер «Новий табір»                   -->
        <!-- ============================================================ -->
        <record id="view_camp_create_wizard_form" model="ir.ui.view">
            <field name="name">camp.create.wizard.form</field>
            <field name="model">camp.create.wizard</field>
            <field name="arch" type="xml">
                <form string="Nowy obóz">
                    <group>
                        <group string="Obóz">
                            <field name="name" placeholder="Obóz NWŚ — turnus 2 (2026)"/>
                            <field name="date_begin"/>
                            <field name="date_end"/>
                            <field name="location" placeholder="Ośrodek Leśna Polana, Drołtowice 12"/>
                            <field name="seats"/>
                        </group>
                        <group string="Finanse (plan)">
                            <field name="currency_id" invisible="1"/>
                            <field name="price_per_child" widget="monetary"/>
                            <field name="cost_lodging_per_day" widget="monetary"/>
                            <field name="cost_food_per_child_day" widget="monetary"/>
                            <field name="salary_wychowawca_per_turnus" widget="monetary"/>
                            <field name="salary_kierownik_per_turnus" widget="monetary"/>
                        </group>
                    </group>
                    <footer>
                        <button name="action_create_camp" type="object"
                                string="Utwórz obóz" class="btn-primary"/>
                        <button string="Anuluj" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_camp_create_wizard" model="ir.actions.act_window">
            <field name="name">Nowy obóz (kreator)</field>
            <field name="res_model">camp.create.wizard</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_camp_create_wizard_form"/>
            <field name="target">new</field>
        </record>

    </data>
</odoo>
