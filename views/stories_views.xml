<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- camp.story — backend views (migrated from fayna_camp_stories) -->
        <record id="camp_story_tree" model="ir.ui.view">
            <field name="name">camp.story.tree</field>
            <field name="model">camp.story</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="event_id"/>
                    <field name="date"/>
                    <field name="title"/>
                    <field name="story_type"/>
                    <field name="author_id"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <record id="camp_story_form" model="ir.ui.view">
            <field name="name">camp.story.form</field>
            <field name="model">camp.story</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_publish" type="object"
                                string="Publish to parents"
                                class="oe_highlight"
                                invisible="state != 'draft'"/>
                        <button name="action_archive" type="object"
                                string="Archive"
                                invisible="state == 'archived'"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="draft,published,archived"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="event_id"/>
                                <field name="date"/>
                                <field name="story_type"/>
                            </group>
                            <group>
                                <field name="public"/>
                                <field name="publish_date" readonly="1"/>
                            </group>
                        </group>

                        <group>
                            <field name="title"/>
                            <field name="author_id"/>
                        </group>

                        <group string="Content">
                            <field name="content"/>
                        </group>

                        <group>
                            <group>
                                <field name="tags"/>
                                <field name="featured_participants"/>
                            </group>
                        </group>

                        <group string="Parent Message">
                            <field name="parent_message"/>
                        </group>

                        <notebook>
                            <page string="Photos">
                                <field name="photo_ids" widget="many2many_tags"/>
                                <separator string="Tagged children (photo consent-gated — RODO wizerunek)"/>
                                <field name="tagged_participant_ids" widget="many2many_tags"
                                       help="On publish, each tagged child must have signed Dodatek 4a (image consent = yes)."/>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="camp_story_kanban" model="ir.ui.view">
            <field name="name">camp.story.kanban</field>
            <field name="model">camp.story</field>
            <field name="arch" type="xml">
                <kanban default_group_by="state" class="o_kanban_small_column">
                    <field name="id"/>
                    <field name="title"/>
                    <field name="date"/>
                    <field name="story_type"/>
                    <field name="author_id"/>
                    <field name="state"/>
                    <field name="public"/>
                    <field name="event_id"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_card oe_kanban_global_click">
                                <div class="oe_kanban_content">
                                    <div class="o_kanban_record_top">
                                        <div class="o_kanban_record_headings">
                                            <strong class="o_kanban_record_title">
                                                <field name="title"/>
                                            </strong>
                                        </div>
                                    </div>
                                    <div class="o_kanban_record_body">
                                        <div class="text-muted small">
                                            <field name="event_id"/>
                                            <t t-if="record.date.value"> · <field name="date"/></t>
                                        </div>
                                        <div class="text-muted small">
                                            <field name="story_type"/>
                                        </div>
                                    </div>
                                    <div class="o_kanban_record_bottom">
                                        <div class="oe_kanban_bottom_left">
                                            <field name="author_id" widget="many2one_avatar_user"/>
                                        </div>
                                        <div class="oe_kanban_bottom_right">
                                            <t t-if="record.public.value">
                                                <span class="badge bg-success">Public</span>
                                            </t>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="camp_story_search" model="ir.ui.view">
            <field name="name">camp.story.search</field>
            <field name="model">camp.story</field>
            <field name="arch" type="xml">
                <search string="Search Stories">
                    <field name="title" string="Title"/>
                    <field name="event_id" string="Camp shift"/>
                    <field name="author_id" string="Author"/>
                    <field name="tags" string="Tags"/>
                    <separator/>
                    <filter string="Draft" name="state_draft"
                            domain="[('state', '=', 'draft')]"/>
                    <filter string="Published" name="state_published"
                            domain="[('state', '=', 'published')]"/>
                    <filter string="Archived" name="state_archived"
                            domain="[('state', '=', 'archived')]"/>
                    <separator/>
                    <filter string="Visible to parents" name="public"
                            domain="[('public', '=', True)]"/>
                    <filter string="Hidden from parents" name="not_public"
                            domain="[('public', '=', False)]"/>
                    <separator/>
                    <filter string="My stories" name="my_stories"
                            domain="[('author_id', '=', uid)]"/>
                    <group expand="0" string="Group By">
                        <filter string="State" name="group_state"
                                context="{'group_by': 'state'}"/>
                        <filter string="Camp shift" name="group_event"
                                context="{'group_by': 'event_id'}"/>
                        <filter string="Author" name="group_author"
                                context="{'group_by': 'author_id'}"/>
                        <filter string="Story type" name="group_type"
                                context="{'group_by': 'story_type'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="camp_story_action" model="ir.actions.act_window">
            <field name="name">Camp Stories</field>
            <field name="res_model">camp.story</field>
            <field name="view_mode">kanban,tree,form</field>
            <field name="search_view_id" ref="camp_story_search"/>
            <field name="context">{'search_default_state_published': 0}</field>
        </record>
    </data>
</odoo>
