        <record id="view_camp_kuratorium_notification_form" model="ir.ui.view">
            <field name="name">camp.kuratorium.notification.form</field>
            <field name="model">camp.kuratorium.notification</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="event_id"/>
                        </group>
                        <group string="Staff">
                            <field name="staff_ids" nolabel="1">
                                <tree editable="bottom">
                                    <field name="partner_id"/>
                                    <field name="role"/>
                                </tree>
                            </field>
                        </group>
                        <group string="Checklist">
                            <field name="checklist_ids" nolabel="1">
                                <tree editable="bottom">
                                    <field name="name"/>
                                </tree>
                            </field>
