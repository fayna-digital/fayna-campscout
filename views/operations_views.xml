        <!-- ================================================================ -->

        <record id="view_camp_report_tree" model="ir.ui.view">
            <field name="name">camp.report.tree</field>
            <field name="model">camp.report</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="title"/>
