        <!-- ================================================================ -->
        <!-- fayna.camp.dziennik                                              -->
        <!-- ================================================================ -->

        <record id="view_fayna_camp_dziennik_tree" model="ir.ui.view">
            <field name="name">fayna.camp.dziennik.tree</field>
            <field name="model">fayna.camp.dziennik</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="display_name"/>
                    <field name="event_id"/>
                    <field name="state"/>
                    <field name="date_start"/>
                </tree>
            </field>
        </record>

        <record id="view_fayna_camp_dziennik_form" model="ir.ui.view">
            <field name="name">fayna.camp.dziennik.form</field>
            <field name="model">fayna.camp.dziennik</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <group>
                            <field name="group_name"/>
                            <field name="event_id"/>
                            <field name="kierownik_id"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                        </group>
                        <group string="Wychowawcy">
                            <field name="wychowawca_ids" nolabel="1" widget="many2many_tags"/>
                        </group>
                        <group string="Aktivності">
                            <field name="activity_ids" nolabel="1">
                                <tree editable="bottom">
                                    <field name="datetime"/>
                                    <field name="content"/>
                                    <field name="author_id"/>
                                </tree>
                            </field>
                        </group>
                        <group string="Нотатки">
                            <field name="note_ids" nolabel="1">
                                <tree editable="bottom">
                                    <field name="date"/>
                                    <field name="note_type"/>
                                    <field name="content"/>
                                    <field name="author_id"/>
                                </tree>
                            </field>
                        </group>
                        <group string="Тижневий план">
                            <field name="plan_line_ids" nolabel="1">
                                <tree editable="bottom">
                                    <field name="week_number"/>
                                    <field name="task"/>
                                    <field name="deadline"/>
                                    <field name="responsible_id"/>
                                </tree>
                            </field>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_fayna_camp_dziennik" model="ir.actions.act_window">
            <field name="name">Dziennik Zajęć</field>
            <field name="res_model">fayna.camp.dziennik</field>
            <field name="view_mode">tree,form</field>
        </record>

    </data>
</odoo>
