            <field name="name">camp.kuratorium.notification.tree</field>
            <field name="model">camp.kuratorium.notification</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="event_id"/>
                </tree>
            </field>
