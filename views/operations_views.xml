        <record id="view_camp_report_form" model="ir.ui.view">
            <field name="name">camp.report.form</field>
            <field name="model">camp.report</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="title"/>
                                <field name="event_id"/>
                                <field name="report_type"/>
                                <field name="author_id"/>
                                <field name="kierownik_id"/>
                            </group>
                            <group>
                                <field name="date_from"/>
                                <field name="date_to"/>
                                <field name="participant_count_total"/>
                                <field name="participant_count_male"/>
                                <field name="participant_count_female"/>
                            </group>
                        </group>
                        <group string="Content">
                            <field name="summary" nolabel="1"/>
                        </group>
                        <group string="Sections">
                            <field name="section_program"/>
                            <field name="section_staff"/>
                            <field name="section_children"/>
                            <field name="section_events"/>
                            <field name="section_kierownik_work"/>
                            <field name="section_recommendations"/>
                        </group>
                        <group string="Summary">
                            <field name="general_assessment"/>
                            <field name="incidents_summary"/>
                            <field name="recommendations"/>
                            <field name="highlights"/>
                            <field name="issues"/>
                        </group>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="action_camp_report" model="ir.actions.act_window">
            <field name="name">Camp Reports (Sprawozdanie)</field>
            <field name="res_model">camp.report</field>
            <field name="view_mode">tree,form</field>
        </record>

