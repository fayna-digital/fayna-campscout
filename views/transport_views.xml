<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ══════════════════════════════════════════════════════════════
             TRANSPORT — views + action + menu
        ══════════════════════════════════════════════════════════════════ -->

        <record id="camp_transport_tree" model="ir.ui.view">
            <field name="name">camp.transport.tree</field>
            <field name="model">camp.transport</field>
            <field name="arch" type="xml">
                <tree decoration-danger="is_overdue == True"
                      decoration-muted="state == 'cancelled'">
                    <field name="name"/>
                    <field name="event_id"/>
                    <field name="trip_type"/>
                    <field name="departure_location"/>
                    <field name="arrival_location"/>
                    <field name="departure_datetime"/>
                    <field name="vehicle_type"/>
                    <field name="participant_count"/>
                    <field name="state"
                           widget="badge"
                           decoration-success="state == 'completed'"
                           decoration-info="state == 'confirmed'"
                           decoration-warning="state == 'planned'"
                           decoration-danger="state == 'cancelled'"/>
                    <field name="is_overdue" invisible="1"/>
                </tree>
            </field>
        </record>

        <record id="camp_transport_form" model="ir.ui.view">
            <field name="name">camp.transport.form</field>
            <field name="model">camp.transport</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_confirm"
                                string="Confirm"
                                type="object"
                                class="btn-primary"
                                invisible="state != 'planned'"/>
                        <button name="action_complete"
                                string="Mark as Completed"
                                type="object"
                                class="btn-primary"
                                invisible="state not in ('planned', 'confirmed')"/>
                        <button name="action_cancel"
                                string="Cancel"
                                type="object"
                                invisible="state in ('completed', 'cancelled')"/>
                        <field name="state"
                               widget="statusbar"
                               statusbar_visible="planned,confirmed,completed"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group string="Trip details">
                                <field name="event_id"/>
                                <field name="trip_type"/>
                                <field name="departure_location"/>
                                <field name="arrival_location"/>
                                <field name="departure_datetime"/>
                                <field name="arrival_datetime"/>
                            </group>
                            <group string="Vehicle &amp; Driver">
                                <field name="vehicle_type"/>
                                <field name="vehicle_registration"/>
                                <field name="transport_company"/>
                                <field name="driver_name"/>
                                <field name="driver_phone"/>
                            </group>
                        </group>
                        <group string="Passengers">
                            <field name="participant_ids" widget="many2many_tags"/>
                            <field name="participant_count" readonly="1"/>
                        </group>
                        <group string="Documentation">
                            <field name="waybill_attachment_id"/>
                        </group>
                        <notebook>
                            <page string="Notes">
                                <field name="notes" placeholder="Special instructions, route notes..."/>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="camp_transport_action" model="ir.actions.act_window">
            <field name="name">Camp Transport</field>
            <field name="res_model">camp.transport</field>
            <field name="view_mode">tree,form</field>
        </record>

        <!-- ══════════════════════════════════════════════════════════════
             MENU — under existing Операції root (views/menus.xml)
        ══════════════════════════════════════════════════════════════════ -->

        <menuitem id="menu_camp_transport"
                  name="Transport"
                  parent="menu_operations"
                  action="camp_transport_action"
                  sequence="60"
                  groups="fayna_camp_portal.group_camp_kierownik"/>

    </data>
</odoo>
