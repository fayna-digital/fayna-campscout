<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ════════════════════════════════════════════════════════════════
             camp.analytics.snapshot — KPI snapshot (immutable)
        ════════════════════════════════════════════════════════════════ -->

        <record id="view_camp_analytics_snapshot_tree" model="ir.ui.view">
            <field name="name">camp.analytics.snapshot.tree</field>
            <field name="model">camp.analytics.snapshot</field>
            <field name="arch" type="xml">
                <tree string="Analytics Snapshots"
                      default_order="snapshot_date desc"
                      create="false" edit="false">
                    <field name="event_id"/>
                    <field name="snapshot_date"/>
                    <field name="registered_count"/>
                    <field name="total_capacity" optional="show"/>
                    <field name="confirmed_count"/>
                    <field name="qualification_signed_count"/>
                    <field name="occupancy_rate"
                           string="Occupancy %"
                           decoration-danger="occupancy_rate &gt;= 100"
                           decoration-warning="occupancy_rate &gt;= 80"/>
                    <field name="revenue_total"/>
                    <field name="avg_order_value"/>
                    <field name="currency_id" column_invisible="1"/>
                </tree>
            </field>
        </record>

        <record id="view_camp_analytics_snapshot_form" model="ir.ui.view">
            <field name="name">camp.analytics.snapshot.form</field>
            <field name="model">camp.analytics.snapshot</field>
            <field name="arch" type="xml">
                <form string="Analytics Snapshot">
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="display_name" readonly="1"/></h1>
                        </div>
                        <group>
                            <group string="Event">
                                <field name="event_id" readonly="1"/>
                                <field name="snapshot_date" readonly="1"/>
                                <field name="currency_id" invisible="1"/>
                            </group>
                        </group>
                        <group string="Attendance">
                            <group>
                                <field name="registered_count" readonly="1"/>
                                <field name="total_capacity" readonly="1"/>
                                <field name="confirmed_count" readonly="1"/>
                                <field name="cancelled_count" readonly="1"/>
                                <field name="qualification_signed_count" readonly="1"/>
                            </group>
                            <group>
                                <field name="occupancy_rate" readonly="1"/>
                            </group>
                        </group>
                        <group string="Financial">
                            <group>
                                <field name="revenue_total" readonly="1"/>
                                <field name="revenue_paid" readonly="1"/>
                                <field name="revenue_pending" readonly="1"/>
                            </group>
                            <group>
                                <field name="avg_order_value" readonly="1"/>
                            </group>
                        </group>
                        <group string="Operations">
                            <group>
                                <field name="incidents_count" readonly="1"/>
                                <field name="support_requests_count" readonly="1"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_camp_analytics_snapshot_graph" model="ir.ui.view">
            <field name="name">camp.analytics.snapshot.graph</field>
            <field name="model">camp.analytics.snapshot</field>
            <field name="arch" type="xml">
                <graph string="Analytics — Registrations over Time" type="bar">
                    <field name="snapshot_date" type="row"/>
                    <field name="registered_count" type="measure"/>
                    <field name="confirmed_count" type="measure"/>
                    <field name="revenue_total" type="measure"/>
                </graph>
            </field>
        </record>

        <record id="view_camp_analytics_snapshot_pivot" model="ir.ui.view">
            <field name="name">camp.analytics.snapshot.pivot</field>
            <field name="model">camp.analytics.snapshot</field>
            <field name="arch" type="xml">
                <pivot string="Analytics Pivot">
                    <field name="event_id" type="row"/>
                    <field name="snapshot_date" type="col"/>
                    <field name="registered_count" type="measure"/>
                    <field name="revenue_total" type="measure"/>
                    <field name="occupancy_rate" type="measure"/>
                </pivot>
            </field>
        </record>

        <record id="view_camp_analytics_snapshot_search" model="ir.ui.view">
            <field name="name">camp.analytics.snapshot.search</field>
            <field name="model">camp.analytics.snapshot</field>
            <field name="arch" type="xml">
                <search string="Search Analytics Snapshots">
                    <field name="event_id" string="Camp Event"/>
                    <field name="snapshot_date" string="Snapshot Date"/>
                    <filter string="Today"
                            name="filter_today"
                            domain="[('snapshot_date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                    <filter string="This Month"
                            name="filter_this_month"
                            domain="[('snapshot_date', '&gt;=', (context_today() + relativedelta(day=1)).strftime('%Y-%m-%d'))]"/>
                    <group expand="0" string="Group By">
                        <filter string="Event" name="group_by_event" context="{'group_by': 'event_id'}"/>
                        <filter string="Date" name="group_by_date" context="{'group_by': 'snapshot_date:month'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_camp_analytics_snapshot" model="ir.actions.act_window">
            <field name="name">Analytics Snapshots</field>
            <field name="res_model">camp.analytics.snapshot</field>
            <field name="view_mode">tree,graph,pivot,form</field>
            <field name="context">{"order": "snapshot_date desc"}</field>
            <field name="search_view_id" ref="view_camp_analytics_snapshot_search"/>
        </record>

        <!-- ════════════════════════════════════════════════════════════════
             camp.marketing.report — wizard (TransientModel popup)
        ════════════════════════════════════════════════════════════════ -->

        <record id="view_camp_marketing_report_form" model="ir.ui.view">
            <field name="name">camp.marketing.report.form</field>
            <field name="model">camp.marketing.report</field>
            <field name="arch" type="xml">
                <form string="Generate Camp Report">
                    <sheet>
                        <group string="Filters">
                            <field name="event_id"/>
                            <field name="report_type"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                        <group string="Metrics" invisible="not event_id">
                            <field name="total_registrations" readonly="1"/>
                            <field name="total_revenue" readonly="1"/>
                            <field name="occupancy_rate" readonly="1"/>
                            <field name="avg_age"
                                   invisible="report_type != 'age_distribution'"
                                   readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </sheet>
                    <footer>
                        <button name="action_generate_report"
                                string="Generate PDF"
                                type="object"
                                class="btn-primary"
                                invisible="not event_id"/>
                        <button string="Cancel"
                                class="btn-secondary"
                                special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_camp_marketing_report_wizard" model="ir.actions.act_window">
            <field name="name">Camp Analytics Report</field>
            <field name="res_model">camp.marketing.report</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <!-- ════════════════════════════════════════════════════════════════
             Menu — Reports submenu under CampScout root
        ════════════════════════════════════════════════════════════════ -->

        <menuitem id="menu_camp_reports_root"
                  name="Reports"
                  parent="menu_campscout_root"
                  sequence="80"
                  groups="fayna_camp_portal.group_camp_organizator,fayna_camp_portal.group_camp_sales"/>

        <menuitem id="menu_camp_marketing_report"
                  name="Generate Analytics Report"
                  parent="menu_camp_reports_root"
                  action="action_camp_marketing_report_wizard"
                  sequence="10"
                  groups="fayna_camp_portal.group_camp_organizator,fayna_camp_portal.group_camp_sales"/>

        <menuitem id="menu_camp_analytics_snapshots"
                  name="Analytics Snapshots"
                  parent="menu_camp_reports_root"
                  action="action_camp_analytics_snapshot"
                  sequence="30"
                  groups="fayna_camp_portal.group_camp_organizator"/>

    </data>
</odoo>
